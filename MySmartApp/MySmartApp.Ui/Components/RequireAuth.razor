@using Microsoft.AspNetCore.Components.Authorization
@using MySmartApp.Ui.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<RequireAuth> Logger
@inject IAuthService AuthService
@implements IDisposable

@if (IsAuthenticated)
{
    @ChildContent
}
else if (IsLoading)
{
    <div class="d-flex justify-center align-center" style="height: 100vh;">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" />
        <MudText Class="ml-3">Vérification de l'authentification...</MudText>
    </div>
}
else
{
    <RedirectToLogin />
}

@code {
[Parameter] public RenderFragment? ChildContent { get; set; }
[Parameter] public string? RedirectUrl { get; set; }
[Parameter] public bool AllowAnonymous { get; set; } = false;
[Parameter] public string? RequiredRole { get; set; }

    private bool IsAuthenticated { get; set; }
    private bool IsLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        // S'abonner aux changements d'état d'authentification
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        
        await CheckAuthenticationStatus();
    }

    private async Task CheckAuthenticationStatus()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            // Vérifier l'état d'authentification
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var isUserAuthenticated = authState.User?.Identity?.IsAuthenticated == true;
            
            Logger.LogDebug("?? Vérification auth: IsAuthenticated={IsAuth}, User={User}", 
                isUserAuthenticated, authState.User?.Identity?.Name ?? "Anonymous");

            if (isUserAuthenticated)
            {
                // Vérifier le rôle requis si spécifié
                if (!string.IsNullOrEmpty(RequiredRole))
                {
                    var hasRequiredRole = authState.User.IsInRole(RequiredRole);
                    if (!hasRequiredRole)
                    {
                        Logger.LogWarning("? Utilisateur authentifié mais sans le rôle requis: {RequiredRole}", RequiredRole);
                        IsAuthenticated = false;
                        return;
                    }
                }

                // Double-vérification avec validation du token
                try
                {
                    var isTokenValid = await AuthService.ValidateTokenAsync();
                    if (!isTokenValid)
                    {
                        Logger.LogWarning("?? Token invalide détecté, déconnexion automatique");
                        await AuthService.LogoutAsync();
                        IsAuthenticated = false;
                    }
                    else
                    {
                        IsAuthenticated = true;
                        Logger.LogDebug("? Utilisateur authentifié et token valide");
                        
                        if (!string.IsNullOrEmpty(RequiredRole))
                        {
                            Logger.LogDebug("? Rôle requis {RequiredRole} validé", RequiredRole);
                        }
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "?? Erreur lors de la validation du token, déconnexion par sécurité");
                    await AuthService.LogoutAsync();
                    IsAuthenticated = false;
                }
            }
            else
            {
                IsAuthenticated = false;
                Logger.LogDebug("? Utilisateur non authentifié");
            }

            // Si l'accès anonyme est autorisé, ne pas rediriger
            if (!IsAuthenticated && !AllowAnonymous)
            {
                Logger.LogInformation("?? Redirection vers login nécessaire");
                // La redirection sera gérée par RedirectToLogin
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "? Erreur lors de la vérification d'authentification");
            IsAuthenticated = false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            await CheckAuthenticationStatus();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "? Erreur lors de la mise à jour de l'état d'authentification");
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}