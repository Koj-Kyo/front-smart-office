@using Microsoft.AspNetCore.Components.Authorization
@using MySmartApp.Ui.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<RequireAuth> Logger
@inject IAuthService AuthService
@implements IDisposable

@if (IsAuthenticated)
{
    @ChildContent
}
else if (IsLoading)
{
    <div class="d-flex justify-center align-center" style="height: 100vh;">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" />
        <MudText Class="ml-3">V�rification de l'authentification...</MudText>
    </div>
}
else
{
    <RedirectToLogin />
}

@code {
[Parameter] public RenderFragment? ChildContent { get; set; }
[Parameter] public string? RedirectUrl { get; set; }
[Parameter] public bool AllowAnonymous { get; set; } = false;
[Parameter] public string? RequiredRole { get; set; }

    private bool IsAuthenticated { get; set; }
    private bool IsLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        // S'abonner aux changements d'�tat d'authentification
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        
        await CheckAuthenticationStatus();
    }

    private async Task CheckAuthenticationStatus()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            // V�rifier l'�tat d'authentification
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var isUserAuthenticated = authState.User?.Identity?.IsAuthenticated == true;
            
            Logger.LogDebug(" V�rification auth: IsAuthenticated={IsAuth}, User={User}", 
                isUserAuthenticated, authState.User?.Identity?.Name ?? "Anonymous");

            if (isUserAuthenticated)
            {
                // V�rifier le r�le requis si sp�cifi�
                if (!string.IsNullOrEmpty(RequiredRole))
                {
                    var hasRequiredRole = authState.User.IsInRole(RequiredRole);
                    if (!hasRequiredRole)
                    {
                        Logger.LogWarning(" Utilisateur authentifi� mais sans le r�le requis: {RequiredRole}", RequiredRole);
                        IsAuthenticated = false;
                        return;
                    }
                }

                // Double-v�rification avec validation du token
                try
                {
                    var isTokenValid = await AuthService.ValidateTokenAsync();
                    if (!isTokenValid)
                    {
                        Logger.LogWarning(" Token invalide d�tect�, d�connexion automatique");
                        await AuthService.LogoutAsync();
                        IsAuthenticated = false;
                    }
                    else
                    {
                        IsAuthenticated = true;
                        Logger.LogDebug(" Utilisateur authentifi� et token valide");
                        
                        if (!string.IsNullOrEmpty(RequiredRole))
                        {
                            Logger.LogDebug(" R�le requis {RequiredRole} valid�", RequiredRole);
                        }
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, " Erreur lors de la validation du token, d�connexion par s�curit�");
                    await AuthService.LogoutAsync();
                    IsAuthenticated = false;
                }
            }
            else
            {
                IsAuthenticated = false;
                Logger.LogDebug(" Utilisateur non authentifi�");
            }

            // Si l'acc�s anonyme est autoris�, ne pas rediriger
            if (!IsAuthenticated && !AllowAnonymous)
            {
                Logger.LogInformation(" Redirection vers login n�cessaire");
                // La redirection sera g�r�e par RedirectToLogin
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, " Erreur lors de la v�rification d'authentification");
            IsAuthenticated = false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            await CheckAuthenticationStatus();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, " Erreur lors de la mise � jour de l'�tat d'authentification");
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}