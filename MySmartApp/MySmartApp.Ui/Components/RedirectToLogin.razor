@using MySmartApp.Ui.Services
@inject NavigationManager Navigation
@inject ILogger<RedirectToLogin> Logger
@inject ITokenProvider TokenProvider

<!-- Message de redirection temporaire -->
<div class="d-flex flex-column justify-center align-center" style="height: 100vh;">
    <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
    <MudText Typo="Typo.h6" Class="mb-2">Authentification requise</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">Redirection vers la page de connexion...</MudText>
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" Style="width: 200px;" />
    <MudText Typo="Typo.caption" Color="Color.Secondary">Si vous n'êtes pas redirigé automatiquement, cliquez sur le bouton ci-dessous.</MudText>
    <MudButton Class="mt-4" 
               Variant="Variant.Filled" 
               Color="Color.Primary"
               OnClick="ManualRedirect"
               StartIcon="@Icons.Material.Filled.Login">
        Aller à la connexion
    </MudButton>
</div>

@code {
    [Parameter] public string? ReturnUrl { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        // Petit délai pour permettre à l'utilisateur de voir le message
        await Task.Delay(1500);
        
        await RedirectToLoginPage();
    }

    private async Task RedirectToLoginPage()
    {
        try
        {
            // Nettoyer les tokens potentiellement corrompus
            await TokenProvider.ClearTokenAsync();
            
            var currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            var returnUrl = ReturnUrl ?? (string.IsNullOrEmpty(currentUrl) || currentUrl == "/" ? "/dashboard" : currentUrl);
            var encodedReturnUrl = Uri.EscapeDataString(returnUrl);
            
            Logger.LogInformation("?? Redirection vers login depuis {CurrentUrl}", currentUrl);
            
            var loginUrl = $"/login?returnUrl={encodedReturnUrl}";
            Navigation.NavigateTo(loginUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "? Erreur lors de la redirection vers login");
            // Fallback: redirection simple
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private async Task ManualRedirect()
    {
        await RedirectToLoginPage();
    }
}