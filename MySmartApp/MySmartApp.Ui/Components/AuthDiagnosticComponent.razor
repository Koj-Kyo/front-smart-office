            return (false, $"Erreur: {ex.Message}");
        }
    }

    private string GetServicesStatus()
    {
        // V�rifier que les services principaux sont enregistr�s
        var services = new List<string>();
        
        if (AuthService != null) services.Add("Auth");
        if (TokenProvider != null) services.Add("Token");
        if (AuthStateProvider != null) services.Add("AuthState");
        
        return services.Any() ? string.Join(", ", services) : "Aucun service d�tect�";
    }

    public class DiagnosticResult
