@using Microsoft.AspNetCore.Components.Authorization
@using MySmartApp.Ui.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthService AuthService
@inject ITokenProvider TokenProvider
@inject ILogger<AuthDiagnosticComponent> Logger

<MudExpansionPanels>
    <MudExpansionPanel>
        <TitleContent>
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.BugReport" Class="mr-2" />
                <MudText>Diagnostic d'authentification</MudText>
            </div>
        </TitleContent>
        <ChildContent>
            <MudButton OnClick="RunDiagnostic" 
                       Variant="Variant.Filled" 
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       Class="mb-4">
                Ex�cuter diagnostic
            </MudButton>

            @if (diagnosticResults.Any())
            {
                <MudList T="string">
                    @foreach (var result in diagnosticResults)
                    {
                        <MudListItem T="string">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@result.Icon" Color="@result.Color" Class="mr-3" />
                                <div>
                                    <MudText Typo="Typo.body1" Style="font-weight: 500;">@result.Title</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@result.Description</MudText>
                                    @if (!string.IsNullOrEmpty(result.Details))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Tertiary">@result.Details</MudText>
                                    }
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private List<DiagnosticResult> diagnosticResults = new();

    private async Task RunDiagnostic()
    {
        diagnosticResults.Clear();
        Logger.LogInformation("D�but du diagnostic d'authentification");

        try
        {
            // 1. V�rifier le token
            var token = await TokenProvider.GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                diagnosticResults.Add(new DiagnosticResult
                {
                    Title = "Token manquant",
                    Description = "Aucun token d'authentification trouv�",
                    Icon = Icons.Material.Filled.Warning,
                    Color = Color.Warning
                });
            }
            else
            {
                diagnosticResults.Add(new DiagnosticResult
                {
                    Title = "Token pr�sent",
                    Description = "Token d'authentification trouv�",
                    Details = $"Longueur: {token.Length} caract�res",
                    Icon = Icons.Material.Filled.CheckCircle,
                    Color = Color.Success
                });

                // 2. Valider le token
                try
                {
                    var isValid = await AuthService.ValidateTokenAsync();
                    if (isValid)
