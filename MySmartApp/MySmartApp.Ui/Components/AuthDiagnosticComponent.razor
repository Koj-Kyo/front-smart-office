    private async Task<(bool success, string details)> TestApiConnectivity()
    {
        try
        {
            // Test simple de validation du token qui indique si l'API r�pond
            var isValid = await AuthService.ValidateTokenAsync();
            return (true, isValid ? "API r�pond et token valide" : "API r�pond mais token invalide");
        }
        catch (HttpRequestException)
        {
            return (false, "Serveur backend non accessible (v�rifiez que l'API est d�marr�e)");
