                var user = authState.User;
                var roles = user?.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                                       .Select(c => c.Value)
                                       .ToList() ?? new List<string>();
                
                diagnosticResults.Add(new DiagnosticResult
                {
                    Title = $"R�les utilisateur ({roles.Count})",
                    Description = roles.Any() ? $"R�les: {string.Join(", ", roles)}" : "Aucun r�le assign�",
                    Icon = Icons.Material.Filled.AdminPanelSettings,
                    Color = roles.Any() ? Color.Info : Color.Warning
                });
            }

            // 5. Profil utilisateur
            try
            {
                var profile = await AuthService.GetCurrentUserAsync();
                if (profile != null)
                {
                    diagnosticResults.Add(new DiagnosticResult
                    {
                        Title = "Profil utilisateur charg�",
                        Description = $"Email: {profile.Email}",
                        Details = $"ID: {profile.Id}, R�les: {string.Join(", ", profile.Roles)}",
                        Icon = Icons.Material.Filled.AccountCircle,
