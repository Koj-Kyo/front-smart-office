@page "/telemetrie"
@using MySmartApp.Ui.Services
@using MySmartApp.Ui.Models
@inject ITelemetrieService TelemetrieService
@inject IDeviceService DeviceService
@inject IDialogService DialogService
@inject ILogger<Telemetrie> Logger
@attribute [Authorize]

<RequireAuth>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-8">
    <MudText Typo="Typo.h4" Class="mb-4"> T�l�m�trie & Analytics</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">Analysez les donn�es de t�l�m�trie de vos p�riph�riques IoT en temps r�el.</MudText>

    <!-- S�lecteur de p�riph�rique et p�riode -->
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="4">
            <MudSelect T="int?" @bind-Value="selectedPeripheriqueId" Label="P�riph�rique" Clearable>
                @foreach (var device in devices)
                {
                    <MudSelectItem T="int?" Value="@((int?)device.Id)">@device.Name (@device.Type)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        
        <MudItem xs="12" sm="3">
            <MudDatePicker @bind-Date="startDate" Label="Date de d�but" />
        </MudItem>
        
        <MudItem xs="12" sm="3">
            <MudDatePicker @bind-Date="endDate" Label="Date de fin" />
        </MudItem>
        
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton OnClick="LoadTelemetrieData" 
                       Variant="Variant.Filled" 
                       Color="Color.Primary"
                       Disabled="@isLoading"
                       FullWidth="true">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Analyser
            </MudButton>
        </MudItem>
    </MudGrid>

    <!-- Statistiques rapides -->
    @if (stats != null)
    {
        <MudGrid Class="mb-6">
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-4 text-center" Elevation="2">
                    <MudText Typo="Typo.h4" Color="Color.Primary">@stats.TotalEvents</MudText>
                    <MudText Typo="Typo.body2">�v�nements</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-4 text-center" Elevation="2">
                    <MudText Typo="Typo.h4" Color="Color.Info">@stats.TotalValue.ToString("F2")</MudText>
                    <MudText Typo="Typo.body2">Valeur totale</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-4 text-center" Elevation="2">
                    <MudText Typo="Typo.h4" Color="Color.Success">@stats.AverageValue.ToString("F2")</MudText>
                    <MudText Typo="Typo.body2">Moyenne</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-4 text-center" Elevation="2">
                    <MudText Typo="Typo.h4" Color="Color.Warning">@stats.MaxValue.ToString("F2")</MudText>
                    <MudText Typo="Typo.body2">Maximum</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    <MudGrid>
        <!-- Graphique principal -->
        <MudItem xs="12" lg="8">
            <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-4"> �volution temporelle</MudText>
                
                @if (isLoading)
                {
                    <div class="d-flex justify-center align-center pa-8">
                        <MudProgressCircular Size="Size.Large" Indeterminate="true" />
                        <MudText Class="ml-4">Chargement des donn�es...</MudText>
                    </div>
                }
                else if (telemetries.Any())
                {
                    <!-- Graphique avec ApexCharts ou Chart.js -->
                    <div class="chart-container" style="height: 400px;">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Graphique des donn�es de t�l�m�trie sur la p�riode s�lectionn�e
                        </MudText>
                        
                        <!-- Simulation d'un graphique -->
                        <div class="d-flex flex-column justify-center align-center pa-4" style="height: 350px; background: linear-gradient(45deg, rgba(var(--mud-palette-primary-rgb), 0.1), rgba(var(--mud-palette-secondary-rgb), 0.1)); border-radius: 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                            <MudText Typo="Typo.h6">Graphique T�l�m�trie</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center">
                                @telemetries.Count �v�nements sur la p�riode du @startDate?.ToString("dd/MM/yyyy") au @endDate?.ToString("dd/MM/yyyy")
                            </MudText>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column align-center pa-8">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingFlat" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary">Aucune donn�e</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">S�lectionnez un p�riph�rique et une p�riode pour voir les donn�es.</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>

        <!-- R�partition par type d'�v�nement -->
        <MudItem xs="12" lg="4">
            <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-4"> R�partition par type</MudText>
                
                @if (stats?.EventsByType.Any() == true)
                {
                    <div class="event-types-chart">
                        @foreach (var eventType in stats.EventsByType.OrderByDescending(x => x.Value))
                        {
                            var percentage = (double)eventType.Value / stats.TotalEvents * 100;
                            <div class="mb-3">
                                <div class="d-flex justify-space-between align-center mb-1">
                                    <MudText Typo="Typo.body2">@eventType.Key</MudText>
                                    <MudText Typo="Typo.caption">@eventType.Value (@percentage.ToString("F1")%)</MudText>
                                </div>
                                <MudProgressLinear Color="@GetEventTypeColor(eventType.Key)" 
                                                   Value="@percentage" 
                                                   Size="Size.Medium" 
                                                   Rounded="true" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.PieChart" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Aucune donn�e � afficher</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>

        <!-- Alertes de t�l�m�trie -->
        <MudItem xs="12" lg="6">
            <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.h6"> Alertes d�tect�es</MudText>
                    <MudButton Size="Size.Small" 
                               Variant="Variant.Text"
                               OnClick="LoadAlerts"
                               Disabled="@isLoadingAlerts">
                        @if (isLoadingAlerts)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                        }
                        Actualiser
                    </MudButton>
                </div>
                
                @if (alerts.Any())
                {
                    <MudList T="string" Dense="true">
                        @foreach (var alert in alerts.Take(5))
                        {
                            <MudListItem T="string">
                                <div class="d-flex align-start">
                                    <MudIcon Icon="@GetAlertIcon(alert.Severity)" 
                                             Color="@GetAlertColor(alert.Severity)" 
                                             Class="mr-3 mt-1" />
                                    <div>
                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                            @alert.AlertType - @alert.PeripheriqueName
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @alert.Description
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @alert.DetectedAt.ToString("dd/MM/yyyy HH:mm")
                                        </MudText>
                                    </div>
                                </div>
                            </MudListItem>
                            
                            @if (alert != alerts.Take(5).Last())
                            {
                                <MudDivider />
                            }
                        }
                    </MudList>
                }
                else
                {
                    <div class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" Class="mb-2" />
                        <MudText Typo="Typo.body2" Color="Color.Success">Aucune alerte d�tect�e</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Tous les syst�mes fonctionnent normalement</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>

        <!-- Donn�es r�centes -->
        <MudItem xs="12" lg="6">
            <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-4"> Donn�es r�centes</MudText>
                
                @if (recentTelemetries.Any())
                {
                    <MudTable Items="@recentTelemetries.Take(10)" 
                              Dense="true" 
                              Hover="true"
                              Class="rounded-lg">
                        <HeaderContent>
                            <MudTh>Heure</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Valeur</MudTh>
                            <MudTh>P�riph�rique</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Heure">@context.Horodatage.ToString("HH:mm:ss")</MudTd>
                            <MudTd DataLabel="Type">
                                <MudChip T="string" Size="Size.Small" Color="@GetEventTypeColor(context.TypeEvenement)">
                                    @context.TypeEvenement
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Valeur">@context.Valeur.ToString("F2")</MudTd>
                            <MudTd DataLabel="P�riph�rique">@context.PeripheriqueName</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <div class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Aucune donn�e r�cente</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Actions flottantes -->
    <MudFab Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.Add"
            Style="position: fixed; bottom: 80px; right: 24px;"
            OnClick="OpenAddTelemetrieDialog"
            Title="Ajouter une donn�e de t�l�m�trie" />
</MudContainer>

<!-- Dialog d'ajout de t�l�m�trie -->
<MudOverlay @bind-Visible="isAddDialogOpen" DarkBackground="true" Absolute="false">
    <MudPaper Class="pa-6" Style="max-width: 700px; margin: 50px auto;">
        <MudText Typo="Typo.h6" Class="mb-4"> Ajouter une donn�e de t�l�m�trie</MudText>

        <MudForm @ref="addForm">
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect T="int" @bind-Value="newTelemetrie.PeripheriqueLogiqueId"
                               Label="P�riph�rique"
                               Required="true"
                               RequiredError="Le p�riph�rique est obligatoire">
                        @foreach (var device in devices)
                        {
                            <MudSelectItem T="int" Value="@device.Id">@device.Name (@device.Type)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="newTelemetrie.TypeEvenement"
                                  Label="Type d'�v�nement"
                                  Required="true"
                                  RequiredError="Le type d'�v�nement est obligatoire"
                                  Placeholder="ex: Consommation_Energie, Impression" />
                </MudItem>
                
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="newTelemetrie.Valeur"
                                     Label="Valeur"
                                     Required="true"
                                     RequiredError="La valeur est obligatoire"
                                     Format="F2" />
                </MudItem>
                
                <MudItem xs="12">
                    <MudTextField @bind-Value="newTelemetrie.DonneesJson"
                                  Label="Donn�es JSON (optionnel)"
                                  Lines="3"
                                  Placeholder='{"temp�rature": 25.5, "humidit�": 60}'
                                  HelperText="Donn�es suppl�mentaires au format JSON" />
                </MudItem>
            </MudGrid>
        </MudForm>

        <div class="d-flex justify-end mt-4">
            <MudButton OnClick="CloseAddDialog" Color="Color.Default" Class="mr-2">
                Annuler
            </MudButton>
            <MudButton OnClick="AddTelemetrie" 
                       Color="Color.Primary" 
                       Variant="Variant.Filled"
                       Disabled="@isAdding">
                @if (isAdding)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Ajouter
            </MudButton>
        </div>
    </MudPaper>
</MudOverlay>

</RequireAuth>

@code {
    // �tat de la page
    private bool isLoading = false;
    private bool isLoadingAlerts = false;
    private bool isAddDialogOpen = false;
    private bool isAdding = false;
    private MudForm? addForm;
    
    // Param�tres de filtre
    private int? selectedPeripheriqueId;
    private DateTime? startDate = DateTime.Today.AddDays(-7);
    private DateTime? endDate = DateTime.Today;
    
    // Donn�es
    private List<PeripheriqueLogiqueDto> devices = new();
    private List<TelemetrieDto> telemetries = new();
    private List<TelemetrieDto> recentTelemetries = new();
    private List<TelemetrieAlertDto> alerts = new();
    private TelemetrieStatsDto? stats;
    
    // Mod�le d'ajout
    private TelemetrieCreateDto newTelemetrie = new() { PeripheriqueLogiqueId = 0, TypeEvenement = "", Valeur = 0, DonneesJson = null };

    protected override async Task OnInitializedAsync()
    {
        await LoadDevices();
        await LoadRecentTelemetries();
        await LoadAlerts();
    }

    private async Task LoadDevices()
    {
        try
        {
            var response = await DeviceService.GetAllDevicesAsync();
            devices = response.ToList();
            Logger.LogInformation(" {Count} p�riph�riques charg�s", devices.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, " Erreur lors du chargement des p�riph�riques");
        }
    }

    private async Task LoadTelemetrieData()
    {
        if (!startDate.HasValue || !endDate.HasValue)
        {
            await DialogService.ShowMessageBox(" Erreur", "Veuillez s�lectionner une p�riode valide.", "OK");
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            // Charger les donn�es de t�l�m�trie
            var telemetrieResponse = await TelemetrieService.GetHistoricalDataAsync(
                startDate.Value, endDate.Value, selectedPeripheriqueId);
            
            if (telemetrieResponse.IsSuccess && telemetrieResponse.Data != null)
            {
                telemetries = telemetrieResponse.Data;
                Logger.LogInformation(" {Count} donn�es de t�l�m�trie charg�es", telemetries.Count);
            }

            // Charger les statistiques si un p�riph�rique est s�lectionn�
            if (selectedPeripheriqueId.HasValue)
            {
                var statsResponse = await TelemetrieService.GetTelemetrieStatsAsync(
                    selectedPeripheriqueId.Value, startDate.Value, endDate.Value);
                
                if (statsResponse.IsSuccess)
                {
                    stats = statsResponse.Data;
                }
            }
            else
            {
                stats = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, " Erreur lors du chargement des donn�es");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadRecentTelemetries()
    {
        try
        {
            var response = await TelemetrieService.GetRecentTelemetriesAsync(selectedPeripheriqueId, 24);
            
            if (response.IsSuccess && response.Data != null)
            {
                recentTelemetries = response.Data.OrderByDescending(t => t.Horodatage).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, " Erreur lors du chargement des donn�es r�centes");
        }
    }

    private async Task LoadAlerts()
    {
        isLoadingAlerts = true;
        StateHasChanged();

        try
        {
            var response = await TelemetrieService.GetTelemetrieAlertsAsync(selectedPeripheriqueId);
            
            if (response.IsSuccess && response.Data != null)
            {
                alerts = response.Data;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, " Erreur lors du chargement des alertes");
        }
        finally
        {
            isLoadingAlerts = false;
            StateHasChanged();
        }
    }

    private void OpenAddTelemetrieDialog()
    {
        newTelemetrie = new TelemetrieCreateDto
        {
            PeripheriqueLogiqueId = selectedPeripheriqueId ?? 0,
            TypeEvenement = "",
            Valeur = 0,
            DonneesJson = null
        };
        isAddDialogOpen = true;
    }

    private void CloseAddDialog()
    {
        isAddDialogOpen = false;
        newTelemetrie = new TelemetrieCreateDto
        {
            PeripheriqueLogiqueId = 0,
            TypeEvenement = "",
            Valeur = 0,
            DonneesJson = null
        };
    }

    private async Task AddTelemetrie()
    {
        if (addForm != null)
        {
            await addForm.Validate();
            if (!addForm.IsValid) return;
        }

        isAdding = true;
        StateHasChanged();

        try
        {
            var result = await TelemetrieService.AddTelemetryAsync(newTelemetrie);
            
            if (result.IsSuccess)
            {
                CloseAddDialog();
                await LoadRecentTelemetries();
                
                // Recharger les donn�es si on est dans la m�me p�riode
                if (selectedPeripheriqueId == newTelemetrie.PeripheriqueLogiqueId)
                {
                    await LoadTelemetrieData();
                }
            }
        }
        finally
        {
            isAdding = false;
            StateHasChanged();
        }
    }

    // M�thodes utilitaires
    private Color GetEventTypeColor(string eventType) => eventType.ToLower() switch
    {
        var type when type.Contains("consommation") => Color.Warning,
        var type when type.Contains("impression") => Color.Info,
        var type when type.Contains("scan") => Color.Success,
        var type when type.Contains("activation") => Color.Primary,
        var type when type.Contains("erreur") => Color.Error,
        _ => Color.Default
    };

    private string GetAlertIcon(string severity) => severity.ToLower() switch
    {
        "critique" => Icons.Material.Filled.Error,
        "avertissement" => Icons.Material.Filled.Warning,
        _ => Icons.Material.Filled.Info
    };

    private Color GetAlertColor(string severity) => severity.ToLower() switch
    {
        "critique" => Color.Error,
        "avertissement" => Color.Warning,
        _ => Color.Info
    };
}