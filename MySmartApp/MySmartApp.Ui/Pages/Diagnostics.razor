@page "/diagnostics"
@inject ILogger<Diagnostics> Logger
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-8">
    <MudText Typo="Typo.h4" Class="mb-6">
        <MudIcon Icon="@Icons.Material.Filled.BugReport" Class="mr-3" />
        Diagnostics de Connexion API
    </MudText>

    <MudGrid>
        <!-- Configuration -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-4">Configuration</MudText>
                
                <MudSimpleTable Style="overflow-x: auto;">
                    <tbody>
                        <tr>
                            <td><strong>URL API Base</strong></td>
                            <td>@_apiBaseUrl</td>
                        </tr>
                        <tr>
                            <td><strong>URL Login</strong></td>
                            <td>@(_apiBaseUrl?.Replace("/api", "") + "/api/Auth/login")</td>
                        </tr>
                        <tr>
                            <td><strong>Timeout</strong></td>
                            <td>@(_timeoutSeconds)s</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <!-- Diagnostic d'authentification -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <AuthDiagnosticComponent />
            </MudPaper>
        </MudItem>

        <!-- Tests de connectivité -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-4">Tests de Connectivité</MudText>
                
                <MudStack Spacing="3">
                    <MudButton Variant="Variant.Filled" 
                              Color="Color.Primary" 
                              OnClick="TestApiConnection"
                              Disabled="@_isTestingConnection"
                              StartIcon="@Icons.Material.Filled.NetworkCheck">
                        @if (_isTestingConnection)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span class="ml-2">Test en cours...</span>
                        }
                        else
                        {
                            <span>Tester la connexion API</span>
                        }
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Secondary" 
                              OnClick="TestLoginEndpoint"
                              Disabled="@_isTestingLogin"
                              StartIcon="@Icons.Material.Filled.Login">
                        @if (_isTestingLogin)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span class="ml-2">Test login...</span>
                        }
                        else
                        {
                            <span>Tester endpoint Login</span>
                        }
                    </MudButton>

                    <MudButton Variant="Variant.Text" 
                              Color="Color.Info" 
                              OnClick="ClearResults"
                              StartIcon="@Icons.Material.Filled.Clear">
                        Effacer les résultats
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <!-- Résultats -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-4">Résultats</MudText>
                
                @if (_testResults.Any())
                {
                    <MudTimeline TimelineOrientation="TimelineOrientation.Vertical">
                        @foreach (var result in _testResults.OrderByDescending(r => r.Timestamp))
                        {
                            <MudTimelineItem Color="@GetResultColor(result.Success)" Size="Size.Small">
                                <ItemContent>
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.body1" Class="@(result.Success ? "mud-success-text" : "mud-error-text")">
                                            @result.Test - @(result.Success ? "? Succès" : "? Échec")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @result.Timestamp.ToString("HH:mm:ss")
                                        </MudText>
                                        @if (!string.IsNullOrEmpty(result.Details))
                                        {
                                            <MudText Typo="Typo.body2" Class="mt-2">
                                                @result.Details
                                            </MudText>
                                        }
                                        @if (!string.IsNullOrEmpty(result.Response))
                                        {
                                            <MudExpansionPanels Elevation="0" Class="mt-2">
                                                <MudExpansionPanel Text="Voir la réponse">
                                                    <pre style="background: #f5f5f5; padding: 10px; border-radius: 4px; font-size: 12px; overflow-x: auto;">@result.Response</pre>
                                                </MudExpansionPanel>
                                            </MudExpansionPanels>
                                        }
                                    </div>
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Aucun test effectué</MudText>
                }
            </MudPaper>
        </MudItem>

        <!-- Instructions -->
        <MudItem xs="12">
            <MudAlert Severity="Severity.Info">
                <MudText Typo="Typo.body2">
                    <strong>Instructions :</strong><br/>
                    1. Assurez-vous que votre API backend est démarrée sur https://localhost:7144<br/>
                    2. Testez d'abord la connexion de base<br/>
                    3. Puis testez l'endpoint de login<br/>
                    4. Vérifiez les résultats pour identifier le problème
                </MudText>
            </MudAlert>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private string? _apiBaseUrl;
    private int _timeoutSeconds;
    private bool _isTestingConnection = false;
    private bool _isTestingLogin = false;
    private List<TestResult> _testResults = new();

    protected override void OnInitialized()
    {
        _apiBaseUrl = Configuration["ApiConfiguration:BaseUrl"] ?? "https://localhost:7144/api";
        _timeoutSeconds = int.TryParse(Configuration["ApiConfiguration:TimeoutSeconds"], out var timeout) ? timeout : 30;
    }

    private async Task TestApiConnection()
    {
        _isTestingConnection = true;
        StateHasChanged();

        try
        {
            using var httpClient = new HttpClient();
            httpClient.Timeout = TimeSpan.FromSeconds(5); // Timeout court pour ce test
            var baseUrl = _apiBaseUrl?.Replace("/api", "") ?? "https://localhost:7144";
            
            var response = await httpClient.GetAsync($"{baseUrl}/swagger/index.html");
            
            var result = new TestResult
            {
                Test = "Connexion API Base",
                Success = response.IsSuccessStatusCode,
                Details = $"Status: {response.StatusCode} ({(int)response.StatusCode})",
                Response = $"Headers: {string.Join(", ", response.Headers.Select(h => $"{h.Key}: {string.Join(", ", h.Value)}"))}",
                Timestamp = DateTime.Now
            };

            _testResults.Add(result);
        }
        catch (Exception ex)
        {
            _testResults.Add(new TestResult
            {
                Test = "Connexion API Base",
                Success = false,
                Details = $"Exception: {ex.GetType().Name}",
                Response = ex.Message,
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            _isTestingConnection = false;
            StateHasChanged();
        }
    }

    private async Task TestLoginEndpoint()
    {
        _isTestingLogin = true;
        StateHasChanged();

        try
        {
            using var httpClient = new HttpClient();
            httpClient.Timeout = TimeSpan.FromSeconds(10);
            var baseUrl = _apiBaseUrl?.Replace("/api", "") ?? "https://localhost:7144";
            httpClient.BaseAddress = new Uri(baseUrl);

            // Test avec des données fictives
            var loginData = new { Email = "test@test.com", Password = "Test123!" };
            var jsonContent = System.Text.Json.JsonSerializer.Serialize(loginData);
            var content = new StringContent(jsonContent, System.Text.Encoding.UTF8, "application/json");

            var response = await httpClient.PostAsync("/api/Auth/login", content);
            var responseContent = await response.Content.ReadAsStringAsync();

            var result = new TestResult
            {
                Test = "Endpoint Login",
                Success = response.StatusCode != System.Net.HttpStatusCode.InternalServerError, // 500 = serveur down
                Details = $"Status: {response.StatusCode} ({(int)response.StatusCode})",
                Response = responseContent,
                Timestamp = DateTime.Now
            };

            _testResults.Add(result);
        }
        catch (Exception ex)
        {
            _testResults.Add(new TestResult
            {
                Test = "Endpoint Login", 
                Success = false,
                Details = $"Exception: {ex.GetType().Name}",
                Response = ex.Message,
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            _isTestingLogin = false;
            StateHasChanged();
        }
    }

    private void ClearResults()
    {
        _testResults.Clear();
        StateHasChanged();
    }

    private Color GetResultColor(bool success) => success ? Color.Success : Color.Error;

    private class TestResult
    {
        public string Test { get; set; } = "";
        public bool Success { get; set; }
        public string Details { get; set; } = "";
        public string Response { get; set; } = "";
        public DateTime Timestamp { get; set; }
    }
}