@page "/zones"
@using MudBlazor
@using MySmartApp.Ui.Services
@using MySmartApp.Ui.Models
@inject IDialogService DialogService
@inject IBackendZoneService BackendZoneService
@inject ILogger<Zone> Logger
@attribute [Authorize]

<RequireAuth>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-8">
    <MudText Typo="Typo.h4" Class="mb-4">Gestion des zones</MudText>
    <MudText Typo="Typo.body1" Class="mb-8">En tant qu'administrateur, vous pouvez ici gérer les zones, affecter des appareils et des utilisateurs.</MudText>

    <div class="d-flex align-center justify-space-between mb-4">
        <MudButton OnClick="OpenAddDialog" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            Ajouter une zone
        </MudButton>
        <MudTextField T="string" 
                      @bind-Value="searchString"
                      Placeholder="Rechercher..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search" 
                      IconSize="Size.Medium" 
                      Class="ml-4"
                      Style="max-width: 300px;"></MudTextField>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center align-center pa-8">
            <MudProgressCircular Size="Size.Large" Indeterminate="true" Class="mr-4" />
            <MudText Typo="Typo.h6">Chargement des zones...</MudText>
        </div>
    }
    else if (filteredZones.Any())
    {
        <MudExpansionPanels MultiExpansion="true" Class="rounded-xl">
            @foreach (var zone in filteredZones)
            {
                <MudExpansionPanel Text="@zone.Nom">
                    <ChildContent>
                        <div class="d-flex flex-column pa-4">
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.h6">Informations</MudText>
                                    <MudText Typo="Typo.body2" Class="mb-2">
                                        <strong>ID:</strong> @zone.Id
                                    </MudText>
                                    <MudText Typo="Typo.body2" Class="mb-2">
                                        <strong>Nom:</strong> @zone.Nom
                                    </MudText>
                                    <MudText Typo="Typo.body2" Class="mb-4">
                                        <strong>Longueur du nom:</strong> @zone.Nom.Length caractères
                                    </MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.h6">Statistiques</MudText>
                                    <MudText Typo="Typo.body2" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Devices" Size="Size.Small" Class="mr-2" />
                                        Périphériques: En cours d'implémentation
                                    </MudText>
                                    <MudText Typo="Typo.body2" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-2" />
                                        Utilisateurs: En cours d'implémentation
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-2" Color="Color.Success" />
                                        Statut: Active
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        </div>
                        <div class="d-flex justify-end pa-2">
                            <MudIconButton OnClick="@(() => OpenEditDialog(zone))" 
                                         Icon="@Icons.Material.Filled.Edit" 
                                         Color="Color.Primary"
                                         Title="Modifier cette zone" />
                            <MudIconButton OnClick="@(() => DeleteZone(zone))" 
                                         Icon="@Icons.Material.Filled.Delete" 
                                         Color="Color.Error"
                                         Title="Supprimer cette zone" />
                        </div>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
    else
    {
        <MudPaper Class="pa-8 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.LocationOff" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
            <MudText Typo="Typo.h5" Color="Color.Secondary">Aucune zone trouvée</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                @if (string.IsNullOrEmpty(searchString))
                {
                    <text>Commencez par créer votre première zone.</text>
                }
                else
                {
                    <text>Aucune zone ne correspond à votre recherche "@searchString".</text>
                }
            </MudText>
            <MudButton OnClick="OpenAddDialog" 
                       Variant="Variant.Filled" 
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">
                Créer la première zone
            </MudButton>
        </MudPaper>
    }
</MudContainer>

<MudOverlay @bind-Visible="isDialogOpen" DarkBackground="true" Absolute="false">
    <MudPaper Class="pa-6" Style="max-width: 600px; margin: 50px auto;">
        <MudText Typo="Typo.h6" Class="mb-4">
            <MudIcon Icon="@(isAdding ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)" Class="mr-3" />
            @(isAdding ? "Ajouter une zone" : "Modifier la zone")
        </MudText>

        <MudForm @ref="form" @bind-IsValid="@isFormValid">
            <MudTextField @bind-Value="editingZone.Nom" 
                         Label="Nom de la zone" 
                         Required="true" 
                         RequiredError="Le nom est obligatoire!"
                         MaxLength="100"
                         Counter="100"
                         HelperText="Donnez un nom descriptif à votre zone"
                         Class="mb-4" />
        </MudForm>

        @if (isEditing && currentZone != null)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Informations système</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">ID: @currentZone.Id</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Longueur actuelle: @currentZone.Nom.Length caractères</MudText>
        }

        <MudGrid Class="mt-4">
            <MudItem xs="6">
                <MudButton OnClick="OnCancel" FullWidth="true" Color="Color.Default">Annuler</MudButton>
            </MudItem>
            <MudItem xs="6">
                <MudButton OnClick="OnSave" 
                           FullWidth="true" 
                           Color="Color.Primary" 
                           Variant="Variant.Filled"
                           Disabled="@(!isFormValid || isProcessing)">
                    @if (isProcessing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @(isAdding ? "Créer" : "Modifier")
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudOverlay>

</RequireAuth>

@code {
    // État de la page
    private bool isLoading = true;
    private bool isDialogOpen = false;
    private bool isAdding = true;
    private bool isEditing = false;
    private bool isFormValid = false;
    private bool isProcessing = false;
    private string searchString = "";
    private MudForm? form;
    
    // Données
    private List<BackendZoneDto> zones = new();
    private BackendZoneDto? currentZone;
    
    // Modèle pour le formulaire
    private ZoneFormModel editingZone = new();
    
    // Propriétés calculées
    private List<BackendZoneDto> filteredZones => 
        string.IsNullOrEmpty(searchString) 
            ? zones 
            : zones.Where(z => z.Nom.Contains(searchString, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadZones();
    }

    private async Task LoadZones()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await BackendZoneService.GetAllZonesAsync();
            
            if (response.IsSuccess && response.Data != null)
            {
                zones = response.Data;
                Logger.LogInformation("✅ {Count} zones chargées", zones.Count);
            }
            else
            {
                Logger.LogWarning("⚠️ Erreur lors du chargement des zones: {Error}", response.ErrorMessage);
                zones = new List<BackendZoneDto>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Erreur lors du chargement des zones");
            zones = new List<BackendZoneDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenAddDialog()
    {
        isAdding = true;
        isEditing = false;
        currentZone = null;
        editingZone = new ZoneFormModel();
        isDialogOpen = true;
    }

    private void OpenEditDialog(BackendZoneDto zone)
    {
        isAdding = false;
        isEditing = true;
        currentZone = zone;
        editingZone = new ZoneFormModel { Nom = zone.Nom };
        isDialogOpen = true;
    }

    private void OnCancel()
    {
        isDialogOpen = false;
        editingZone = new ZoneFormModel();
        currentZone = null;
        isFormValid = false;
    }

    private async Task OnSave()
    {
        if (form != null)
        {
            await form.Validate();
            if (!form.IsValid) return;
        }

        isProcessing = true;
        StateHasChanged();

        try
        {
            if (isAdding)
            {
                // Création
                var createDto = new ZoneCreationDto(editingZone.Nom);
                var result = await BackendZoneService.CreateZoneAsync(createDto);
                
                if (result.IsSuccess)
                {
                    OnCancel();
                    await LoadZones();
                }
            }
            else if (currentZone != null)
            {
                // Modification
                var updateDto = new ZoneUpdateDto(editingZone.Nom);
                var result = await BackendZoneService.UpdateZoneAsync(currentZone.Id, updateDto);
                
                if (result.IsSuccess)
                {
                    OnCancel();
                    await LoadZones();
                }
            }
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task DeleteZone(BackendZoneDto zone)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "🗑️ Confirmation de suppression",
            $"Êtes-vous sûr de vouloir supprimer la zone '{zone.Nom}' ?\n\nCette action est irréversible.",
            yesText: "Supprimer",
            cancelText: "Annuler");

        if (confirmed == true)
        {
            var result = await BackendZoneService.DeleteZoneAsync(zone.Id);
            
            if (result.IsSuccess)
            {
                await LoadZones();
            }
        }
    }

    // Modèle pour le formulaire
    public class ZoneFormModel
    {
        public string Nom { get; set; } = "";
    }
}