    /// <summary>
    /// Retourne la couleur en fonction du pourcentage de changement
    /// </summary>
    private Color GetChangeColor(double changePercent)
    {
return changePercent >= 0 ? Color.Success : Color.Error;
    }

    private string FormatChangePercent(double changePercent)
    {
        return changePercent > 0 ? $"+{changePercent}%" : $"{changePercent}%";
    }

