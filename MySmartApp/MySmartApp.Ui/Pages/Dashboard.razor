@page "/dashboard"
@using MySmartApp.Ui.Layout
@using MySmartApp.Ui.Services
@using MySmartApp.Ui.Models
@using MySmartApp.Ui.Components.Dashboard
@inject IAuthService AuthService
@inject ILogger<Dashboard> Logger
@inject ICommandeService CommandeService
@inject IWeatherService WeatherService
@inject IDashboardStatsService DashboardStatsService
@inject ISnackbar Snackbar
@attribute [Authorize]
@implements IDisposable

<PageTitle>Dashboard - Smart Office</PageTitle>

<RequireAuth>
    @* Header avec barre de recherche et navigation *@
    <DashBoardHeader />

    @* ? Barre d'outils Dashboard avec contr�les *@
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-2">
        <MudPaper Class="pa-2 mb-4" Elevation="1">
            <div class="d-flex justify-space-between align-center">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="mr-2" />
                    <MudText Typo="Typo.h6">Dashboard Smart Office</MudText>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudSwitch T="bool" @bind-Checked="_autoRefreshEnabled"
                              Label="Auto-actualisation"
                              Color="Color.Primary"
                              Size="Size.Small" />
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                                  OnClick="RefreshDashboardAsync"
                                  Disabled="_isDashboardLoading"
                                  Color="Color.Primary"
                                  Title="Actualiser le Dashboard" />
                    @if (_isDashboardLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else if (_lastUpdated.HasValue)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Mis � jour: @_lastUpdated.Value.ToString("HH:mm:ss")
                        </MudText>
                    }
                </div>
            </div>
        </MudPaper>
    </MudContainer>

    @* Contenu principal du Dashboard *@
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
        
        @* Section 1: Hero Section avec m�t�o (CONSERV�E) *@
        <MudPaper Class="pa-6 rounded-xl mb-4" Style="background: linear-gradient(135deg, #14B8A6 0%, #06B6D4 100%); color: white; position: relative; overflow: hidden;">
            <MudGrid>
                @* Colonne gauche : Le texte et la m�t�o *@
                <MudItem xs="12" sm="7" md="8">
                    <MudText Typo="Typo.h5" GutterBottom="true" Style="color: white; font-weight: bold;">
                        Bonjour, @(_currentUserName ?? "User") !
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: rgba(255, 255, 255, 0.9);">
                        Bienvenue dans votre espace Smart Office. @(_weatherGreeting)
                    </MudText>

                    @if (_weatherData != null)
                    {
                        <div class="d-flex align-center mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.DeviceThermostat" Style="color: rgba(255, 255, 255, 0.9);" Class="mr-2" />
                            <MudText Typo="Typo.body1" Class="font-weight-bold" Style="color: white;">
                                @(_weatherData.Temperature.ToString("F1"))�C
                            </MudText>
                            <MudText Typo="Typo.body2" Class="ml-2" Style="color: rgba(255, 255, 255, 0.8);">
                                (ressenti @(_weatherData.FeelsLike.ToString("F1"))�C)
                            </MudText>
                        </div>

                        <div class="d-flex align-center mb-2">
                            <MudIcon Icon="@_weatherData.GetWeatherIcon()" Style="color: rgba(255, 255, 255, 0.9);" Class="mr-2" />
                            <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.8);">
                                @_weatherData.Description
                            </MudText>
                        </div>

                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Air" Style="color: rgba(255, 255, 255, 0.9);" Class="mr-2" />
                            <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.8);">
                                Vent: @(_weatherData.WindSpeed.ToString("F1")) km/h | Humidit�: @_weatherData.Humidity%
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <MudProgressCircular Color="Color.Surface" Size="Size.Small" Indeterminate="true" />
                    }
                </MudItem>

                @* Colonne droite : L'image de l'illustration *@
                <MudItem xs="12" sm="5" md="4" Class="d-flex justify-center align-center">
                    <MudImage Src="img/Humaaan.png" Style="max-height: 200px; width: auto;" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* Section 2: KPIs (Key Performance Indicators) *@
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="rounded-xl" Style="height: 100%;">
                    <MudCardContent>
                        @if (_isDashboardLoading)
                        {
                            <div class="d-flex justify-center align-center" style="height: 100px;">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Devices" Color="Color.Primary" Size="Size.Large" />
                                <MudChip T="string" Size="Size.Small" Color="@GetChangeColor(_stats?.DevicesChangePercent ?? 0)">
                                    @FormatChangePercent(_stats?.DevicesChangePercent ?? 0)
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">
                                @(_stats?.ActiveDevices ?? 0)/@(_stats?.TotalDevices ?? 0)
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Appareils Actifs
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="rounded-xl" Style="height: 100%;">
                    <MudCardContent>
                        @if (_isDashboardLoading)
                        {
                            <div class="d-flex justify-center align-center" style="height: 100px;">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Success" Size="Size.Large" />
                                <MudChip T="string" Size="Size.Small" Color="@GetChangeColor(_stats?.UsersChangePercent ?? 0)">
                                    @FormatChangePercent(_stats?.UsersChangePercent ?? 0)
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">
                                @(_stats?.ActiveUsers ?? 0)/@(_stats?.TotalUsers ?? 0)
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Utilisateurs Actifs
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="rounded-xl" Style="height: 100%;">
                    <MudCardContent>
                        @if (_isDashboardLoading)
                        {
                            <div class="d-flex justify-center align-center" style="height: 100px;">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Color="Color.Warning" Size="Size.Large" />
                                <MudChip T="string" Size="Size.Small" Color="@GetChangeColor(_stats?.IncidentsChangePercent ?? 0)">
                                    @FormatChangePercent(_stats?.IncidentsChangePercent ?? 0)
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">
                                @(_stats?.OpenIncidents ?? 0)/@(_stats?.TotalIncidents ?? 0)
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Tickets Ouverts
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="rounded-xl" Style="height: 100%;">
                    <MudCardContent>
                        @if (_isDashboardLoading)
                        {
                            <div class="d-flex justify-center align-center" style="height: 100px;">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Info" Size="Size.Large" />
                                <MudChip T="string" Size="Size.Small" Color="@GetChangeColor(_stats?.EnergyChangePercent ?? 0)">
                                    @FormatChangePercent(_stats?.EnergyChangePercent ?? 0)
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">
                                @(_stats?.EnergyConsumed.ToString("F1") ?? "0") kWh
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Consommation �nerg�tique
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @* ========================================
           ? SECTION WIDGETS PHASE 3.5 - NOUVEAU
           ======================================== *@
        <MudGrid Class="mb-4" Spacing="3">
            @* Row 1: Alarmes + Activit� R�cente *@
            <MudItem xs="12" md="6">
                <ActiveAlarmsWidget MaxAlarmsDisplayed="5" 
                                   RefreshIntervalSeconds="60" 
                                   AutoRefresh="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <RecentActivityWidget MaxActivitiesDisplayed="10" 
                                     PageSize="20" />
            </MudItem>

            @* Row 2: Logs Critiques + M�triques Devices *@
            <MudItem xs="12" md="6">
                <CriticalLogsWidget MaxLogsDisplayed="5" 
                                   HoursBack="24" 
                                   MaxResults="50" />
            </MudItem>
            <MudItem xs="12" md="6">
                <DeviceMetricsWidget MaxDevicesDisplayed="5" />
            </MudItem>
        </MudGrid>

        @* Section 3: Layout principal en 2 colonnes (@* Conserv� mais avec ajout de la classe "mt-4" *) *@
        <MudGrid>
            @* Colonne gauche (70%) *@
            <MudItem xs="12" md="8">
                @* Graphique de consommation d'�nergie *@
                <MudPaper Class="pa-4 rounded-xl mb-4">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudText Typo="Typo.h6">Consommation �nerg�tique</MudText>
                        <MudSelect T="string" @bind-Value="_selectedPeriod" Variant="Variant.Outlined" 
                                   Margin="Margin.Dense" Style="width: 150px;" OnChange="LoadEnergyData">
                            <MudSelectItem Value="@("month")">Mensuel</MudSelectItem>
                            <MudSelectItem Value="@("week")">Hebdomadaire</MudSelectItem>
                            <MudSelectItem Value="@("day")">Quotidien</MudSelectItem>
                        </MudSelect>
                    </div>
                    <MudChart ChartType="ChartType.Line" 
                              ChartSeries="@_energySeries" 
                              XAxisLabels="@_energyLabels" 
                              Width="100%" 
                              Height="350px"
                              ChartOptions="@_chartOptions" />
                </MudPaper>

                @* Activit� des appareils par type *@
                <MudPaper Class="pa-4 rounded-xl mb-4">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudText Typo="Typo.h6">Activit� des Appareils</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                                      OnClick="@(async () => await LoadDeviceActivityAsync())" 
                                      Color="Color.Primary" />
                    </div>
                    <MudChart ChartType="ChartType.Donut" 
                              InputData="@_deviceActivityData" 
                              InputLabels="@_deviceActivityLabels"
                              Width="100%" 
                              Height="300px" />
                </MudPaper>

                @* Contr�le rapide des appareils *@
                <MudPaper Class="pa-4 rounded-xl">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudText Typo="Typo.h6">Contr�le Rapide</MudText>
                        <MudSwitch T="bool" @bind-Checked="_mainSwitch" 
                                  Color="Color.Primary" 
                                  Label="@(_mainSwitch ? "Tout �teindre" : "Tout allumer")" />
                    </div>
                    <MudGrid>
                        <MudItem xs="6" sm="3">
                            <DeviceCard Icon="@Icons.Material.Filled.AcUnit" 
                                       DeviceName="Climatisation" 
                                       PeripheriqueId="1"
                                       OnToggle="@((isOn) => SendDeviceCommand(1, isOn ? "TurnOn" : "TurnOff"))" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <DeviceCard Icon="@Icons.Material.Filled.Lightbulb" 
                                       DeviceName="�clairage"
                                       PeripheriqueId="2"
                                       OnToggle="@((isOn) => SendDeviceCommand(2, isOn ? "TurnOn" : "TurnOff"))" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <DeviceCard Icon="@Icons.Material.Filled.Thermostat" 
                                       DeviceName="Temp�rature"
                                       PeripheriqueId="3" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <DeviceCard Icon="@Icons.Material.Filled.Router" 
                                       DeviceName="R�seau"
                                       PeripheriqueId="4"
                                       OnToggle="@((isOn) => SendDeviceCommand(4, isOn ? "TurnOn" : "TurnOff"))" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            @* Colonne droite (30%) *@
            <MudItem xs="12" md="4">
                @* Mes Appareils *@
                <MudPaper Class="pa-4 rounded-xl mb-4">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudText Typo="Typo.h6">Mes Appareils</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowForwardIos" 
                                      OnClick="NavigateToDevices" 
                                      Color="Color.Primary" 
                                      Size="Size.Small" />
                    </div>
                    <MudGrid>
                        <MudItem xs="6">
                            <DeviceCard Icon="@Icons.Material.Filled.AcUnit" 
                                       DeviceName="A/C" 
                                       DeviceColor="Purple" 
                                       IsOn="true"
                                       PeripheriqueId="11" 
                                       OnToggle="@((isOn) => SendDeviceCommand(11, isOn ? "TurnOn" : "TurnOff"))" />
                        </MudItem>
                        <MudItem xs="6">
                            <DeviceCard Icon="@Icons.Material.Filled.Router" 
                                       DeviceName="Router" 
                                       DeviceColor="Yellow" 
                                       IsOn="false"
                                       PeripheriqueId="12" 
                                       OnToggle="@((isOn) => SendDeviceCommand(12, isOn ? "TurnOn" : "TurnOff"))" />
                        </MudItem>
                        <MudItem xs="6">
                            <DeviceCard Icon="@Icons.Material.Filled.MusicNote" 
                                       DeviceName="Audio" 
                                       DeviceColor="Orange" 
                                       IsOn="true"
                                       PeripheriqueId="13" 
                                       OnToggle="@((isOn) => SendDeviceCommand(13, isOn ? "TurnOn" : "TurnOff"))" />
                        </MudItem>
                        <MudItem xs="6">
                            <DeviceCard Icon="@Icons.Material.Filled.Lightbulb" 
                                       DeviceName="Lampes" 
                                       DeviceColor="Cyan" 
                                       IsOn="false"
                                       PeripheriqueId="14" 
                                       OnToggle="@((isOn) => SendDeviceCommand(14, isOn ? "TurnOn" : "TurnOff"))" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @* Widget t�l�m�trie *@
                <MudPaper Class="pa-4 rounded-xl mb-4">
                    <TelemetrieWidgetComponent OnViewDetails="@(() => NavigationManager.NavigateTo("/telemetrie"))" />
                </MudPaper>

                @* Mes tickets *@
                <MudPaper Class="pa-4 rounded-xl mb-4">
                    <MyTicketsComponent MaxDisplayCount="3" />
                </MudPaper>

                @* Notifications r�centes *@
                <MudPaper Class="pa-4 rounded-xl mb-4">
                    <NotificationsPanelComponent MaxDisplayCount="4" 
                                               OnViewAll="@(() => NavigationManager.NavigateTo("/notifications"))" />
                </MudPaper>

                @* Gestion des zones (compacte) *@
                <MudPaper Class="pa-4 rounded-xl">
                    <ZoneManagementComponent ShowMaxZones="3"
                                           ShowZoneStats="false"
                                           OnZoneSelected="NavigateToZoneDetails"
                                           OnShowAllZonesRequested="NavigateToAdminZones" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</RequireAuth>

@code{
    [Parameter] public bool switchb { get; set; } = true;
    @inject NavigationManager NavigationManager

    private string? _currentUserName;
    private string? _currentUserRole;
    private bool _mainSwitch = false;
    private bool _isDashboardLoading = true;
    private bool _autoRefreshEnabled = true;
    private DateTime? _lastUpdated;
    
    // Donn�es m�t�o
    private WeatherData? _weatherData;
    private string _weatherGreeting = "Bonne journ�e !";
  
    // Statistiques du dashboard
    private DashboardStats? _stats;
    
    // Donn�es pour les graphiques
    private string _selectedPeriod = "month";
    private List<ChartSeries> _energySeries = new();
    private string[] _energyLabels = Array.Empty<string>();
    private double[] _deviceActivityData = Array.Empty<double>();
    private string[] _deviceActivityLabels = Array.Empty<string>();
    
    // Timer pour rafra�chissement automatique
    private Timer? _refreshTimer;
    private readonly TimeSpan _refreshInterval = TimeSpan.FromSeconds(30);
    
    // Options pour les graphiques
    private ChartOptions _chartOptions = new()
    {
        YAxisTicks = 50,
        MaxNumYAxisTicks = 6,
        YAxisLines = true,
        XAxisLines = false,
        LineStrokeWidth = 3
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isDashboardLoading = true;
            
            // Charger les donn�es en parall�le pour optimiser le temps de chargement
            var userTask = LoadUserDataAsync();
            var weatherTask = LoadWeatherDataAsync();
            var statsTask = LoadDashboardStatsAsync();
            var energyTask = LoadEnergyDataAsync();
            var devicesTask = LoadDeviceActivityAsync();

            await Task.WhenAll(userTask, weatherTask, statsTask, energyTask, devicesTask);
    
            // ? D�marrer le rafra�chissement automatique
     StartAutoRefresh();
          
  // ? Marquer comme mis � jour
            _lastUpdated = DateTime.Now;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erreur lors de l'initialisation du Dashboard");
            Snackbar.Add("Erreur lors du chargement du Dashboard", Severity.Error);
        }
        finally
        {
      _isDashboardLoading = false;
         StateHasChanged();
        }
    }

    /// <summary>
    /// ? D�marre le rafra�chissement automatique des donn�es
    /// </summary>
    private void StartAutoRefresh()
  {
        if (!_autoRefreshEnabled) return;
     
        _refreshTimer = new Timer(async _ =>
     {
            try
    {
     await InvokeAsync(async () =>
    {
        Logger.LogDebug(" Rafra�chissement automatique du Dashboard");
            
             // Rafra�chir seulement les donn�es critiques (pas la m�t�o)
  var statsTask = LoadDashboardStatsAsync();
      var energyTask = LoadEnergyDataAsync();
  var devicesTask = LoadDeviceActivityAsync();
 
             await Task.WhenAll(statsTask, energyTask, devicesTask);
         StateHasChanged();
      
        // ? Mettre � jour le timestamp
     _lastUpdated = DateTime.Now;
      });
  }
    catch (Exception ex)
 {
       Logger.LogError(ex, "Erreur lors du rafra�chissement automatique");
            }
        }, null, _refreshInterval, _refreshInterval);
  }

    /// <summary>
    /// ? Arr�te le rafra�chissement automatique
    /// </summary>
    private void StopAutoRefresh()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;
 }

    /// <summary>
    /// ? Rafra�chissement manuel avec feedback utilisateur
    /// </summary>
    private async Task RefreshDashboardAsync()
    {
try
        {
      _isDashboardLoading = true;
            StateHasChanged();
        
            // Recharger les donn�es critiques imm�diatement
   await Task.WhenAll( LoadDashboardStatsAsync(), LoadEnergyDataAsync(), LoadDeviceActivityAsync());
    
        // ? Mettre � jour le timestamp
     _lastUpdated = DateTime.Now;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erreur lors du rafra�chissement du Dashboard");
        }
        finally
        {
      _isDashboardLoading = false;
         StateHasChanged();
        }
    }

    private async Task LoadUserDataAsync()
    {
        try
        {
  var currentUser = await AuthService.GetCurrentUserAsync();
      if (currentUser != null)
            {
   _currentUserName = currentUser.FirstName ?? currentUser.Email?.Split('@')[0] ?? "User";
                _currentUserRole = currentUser.Roles.FirstOrDefault() ?? "User";
            }
        }
        catch (Exception ex)
      {
    Logger.LogError(ex, "Erreur lors du chargement du profil utilisateur");
_currentUserName = "User";
  _currentUserRole = "User";
      }
    }

    private async Task LoadWeatherDataAsync()
    {
        try
        {
            _weatherData = await WeatherService.GetCurrentWeatherAsync();
            if (_weatherData != null)
            {
                _weatherGreeting = _weatherData.Temperature > 20 ? "Bonne journ�e !" : "Bonne soir�e !";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erreur lors du chargement des donn�es m�t�o");
            Snackbar.Add("Erreur lors du chargement des donn�es m�t�o", Severity.Error);
        }
    }

    private async Task LoadDashboardStatsAsync()
    {
        try
        {
            _stats = await DashboardStatsService.GetDashboardStatsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erreur lors du chargement des statistiques du dashboard");
            Snackbar.Add("Erreur lors du chargement des statistiques du dashboard", Severity.Error);
        }
    }

    private async Task LoadEnergyDataAsync()
 {
        try
   {
            var energyData = await DashboardStatsService.GetEnergyConsumptionDataAsync(_selectedPeriod);
  
 if (energyData?.Any() == true)
    {
 _energyLabels = energyData.Select(d => d.Label).ToArray();
_energySeries = new List<ChartSeries>
 {
 new ChartSeries
  {
       Name = "Consommation (kWh)",
  Data = energyData.Select(d => d.Value).ToArray()
           }
      };
      
     Logger.LogDebug(" Donn�es �nerg�tiques charg�es: {Count} points", energyData.Count);
   }
      else
  {
       Logger.LogWarning(" Aucune donn�e �nerg�tique disponible");
 _energyLabels = Array.Empty<string>();
          _energySeries = new List<ChartSeries>();
     }
  
        StateHasChanged();
        }
catch (Exception ex)
      {
       Logger.LogError(ex, " Erreur lors du chargement des donn�es d'�nergie");
       // Conserver les derni�res donn�es valides en cas d'erreur
        }
    }

    private async Task LoadDeviceActivityAsync()
    {
try
  {
            var activityData = await DashboardStatsService.GetDeviceActivityDataAsync();
        
      if (activityData?.Any() == true)
     {
   _deviceActivityLabels = activityData.Select(d => d.DeviceType).ToArray();
_deviceActivityData = activityData.Select(d => (double)d.Count).ToArray();
      
      Logger.LogDebug(" Activit� appareils charg�e: {Count} types", activityData.Count);
 }
            else
  {
        Logger.LogWarning(" Aucune donn�e d'activit� disponible");
     _deviceActivityLabels = Array.Empty<string>();
    _deviceActivityData = Array.Empty<double>();
   }
 
      StateHasChanged();
     }
        catch (Exception ex)
     {
 Logger.LogError(ex, " Erreur lors du chargement de l'activit� des appareils");
  // Conserver les derni�res donn�es valides en cas d'erreur
        }
    }

    /// <summary>
    /// Envoie une commande � un p�riph�rique IoT
    /// </summary>
    private async Task SendDeviceCommand(int peripheriqueId, string nomCommande, string? valeur = null)
    {
        var result = await CommandeService.SendCommandAsync(peripheriqueId, nomCommande, valeur);
        
        if (result.IsSuccess)
        {
  Logger.LogDebug("Dashboard: Commande {Command} ex�cut�e sur p�riph�rique {Id}", nomCommande, peripheriqueId);
     Snackbar.Add($"Commande envoy�e avec succ�s", Severity.Success);
}
        else
 {
