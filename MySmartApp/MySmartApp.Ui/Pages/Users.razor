    private Color GetRoleColor(string role) => role.ToLower() switch
    {
        "admin" => Color.Error,
        "manager" => Color.Warning,
        "employee" => Color.Primary,
        "user" => Color.Info,
        "viewer" => Color.Secondary,
        _ => Color.Default
    };

