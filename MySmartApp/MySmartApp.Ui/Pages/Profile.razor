@page "/profile"
@using MudBlazor
@using MySmartApp.Ui.Services
@using MySmartApp.Ui.Models
@inject IUserManagementService UserManagementService
@inject IAuthService AuthService
@inject IDialogService DialogService
@inject ILogger<Profile> Logger
@attribute [Authorize]

<style>
    .profile-container {
        padding: 2rem;
        border-radius: 20px;
        margin: 1rem;
        background: var(--mud-palette-surface);
        transition: all 0.3s ease;
    }

    .profile-card {
        background: var(--mud-palette-surface);
        border-radius: 16px;
        box-shadow: var(--mud-elevation-4);
        overflow: hidden;
        border: 1px solid var(--mud-palette-divider);
        transition: all 0.3s ease;
    }
    
    .profile-header {
        display: flex;
        align-items: center;
        padding: 2rem 2rem 1.5rem 2rem;
        background: var(--mud-palette-background);
        border-bottom: 1px solid var(--mud-palette-divider);
        transition: all 0.3s ease;
    }
    
    .profile-avatar {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        margin-right: 1.5rem;
        object-fit: cover;
        border: 3px solid var(--mud-palette-surface);
        box-shadow: var(--mud-elevation-2);
    }
    
    .profile-info h2 {
        margin: 0 0 0.25rem 0;
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
    }
    
    .profile-info p {
        margin: 0;
        color: var(--mud-palette-text-secondary);
        font-size: 0.9rem;
    }
    
    .edit-btn {
        margin-left: auto;
        background: var(--mud-palette-primary);
        color: var(--mud-palette-primary-text);
        border: none;
        padding: 0.5rem 1.2rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    
    .edit-btn:hover {
        background: var(--mud-palette-primary-darken);
        transform: translateY(-1px);
    }
    
    .profile-form {
        padding: 1.5rem 2rem 2rem 2rem;
    }
    
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }
    
    .form-field {
        display: flex;
        flex-direction: column;
    }
    
    .form-field label {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--mud-palette-text-primary);
        margin-bottom: 0.5rem;
    }
    
    .form-field input, .form-field select {
        padding: 0.75rem 0.875rem;
        border: 1px solid var(--mud-palette-divider);
        border-radius: 8px;
        font-size: 0.875rem;
        background: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
        transition: all 0.2s ease;
    }
    
    .form-field input:focus, .form-field select:focus {
        outline: none;
        border-color: var(--mud-palette-primary);
        box-shadow: 0 0 0 3px var(--mud-palette-primary-hover);
    }
    
    .form-field input[readonly], .form-field select[disabled] {
        background: var(--mud-palette-background);
        color: var(--mud-palette-text-secondary);
        cursor: not-allowed;
    }
    
    .form-field input::placeholder {
        color: var(--mud-palette-text-disabled);
    }
    
    .email-section {
        border-top: 1px solid var(--mud-palette-divider);
        padding-top: 1.5rem;
        margin-top: 1.5rem;
    }
    
    .email-section h3 {
        font-size: 1rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        margin-bottom: 1rem;
    }
    
    .email-item {
        display: flex;
        align-items: center;
        padding: 1rem;
        background: var(--mud-palette-background);
        border: 1px solid var(--mud-palette-divider);
        border-radius: 12px;
        margin-bottom: 0.75rem;
        transition: all 0.2s ease;
    }
    
    .email-item:hover {
        background: var(--mud-palette-action-hover);
    }
    
    .email-icon {
        width: 18px;
        height: 18px;
        margin-right: 0.75rem;
        color: var(--mud-palette-primary);
        flex-shrink: 0;
    }
    
    .email-details p {
        margin: 0;
    }
    
    .email-details .email-address {
        font-weight: 500;
        color: var(--mud-palette-text-primary);
        font-size: 0.875rem;
    }
    
    .email-details .email-date {
        font-size: 0.75rem;
        color: var(--mud-palette-text-secondary);
        margin-top: 0.25rem;
    }
    
    .add-email-btn {
        display: inline-flex;
        align-items: center;
        background: none;
        border: none;
        color: var(--mud-palette-primary);
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        margin-top: 0.5rem;
        padding: 0.5rem 0;
        transition: color 0.2s ease;
    }
    
    .add-email-btn:hover {
        color: var(--mud-palette-primary-darken);
    }
    
    .save-section {
        display: flex;
        justify-content: flex-end;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--mud-palette-divider);
    }
</style>

<RequireAuth>
    <MudContainer MaxWidth="MaxWidth.Medium">
        <div class="profile-card">
            <!-- Profile Header -->
            <div class="profile-header">
                <img src="@(userProfile.AvatarUrl ?? "/img/admin.jpg")" alt="Profile Picture" class="profile-avatar" />
                <div class="profile-info">
                    <h2>@(userProfile.FullName ?? "Nom non défini")</h2>
                    <p>@userProfile.Email</p>
                    @if (currentUser != null && currentUser.Roles.Any())
                    {
                        <div class="d-flex gap-1 mt-1">
                            @foreach (var role in currentUser.Roles.Take(3))
                            {
                                <MudChip T="string" Size="Size.Small" Color="@GetRoleColor(role)">
                                    @role
                                </MudChip>
                            }
                        </div>
                    }
                </div>
                <MudButton OnClick="ToggleEdit" 
                           Variant="@(isEditing ? Variant.Outlined : Variant.Filled)" 
                           Color="Color.Primary"
                           Class="ml-auto">
                    @(isEditing ? "Annuler" : "Modifier")
                </MudButton>
            </div>

            <!-- Profile Form -->
            <div class="profile-form">
                <div class="form-section">
                    <div class="form-row">
                        <div class="form-field">
                            <label>Full Name</label>
                            <input type="text" @bind="userProfile.FullName" placeholder="Your full name" readonly="@(!isEditing)" />
                        </div>
                        <div class="form-field">
                            <label>Nick Name</label>
                            <input type="text" @bind="userProfile.NickName" placeholder="Your nickname" readonly="@(!isEditing)" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-field">
                            <label>Gender</label>
                            <select @bind="userProfile.Gender" disabled="@(!isEditing)">
                                <option value="">Select gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Country</label>
                            <select @bind="userProfile.Country" disabled="@(!isEditing)">
                                <option value="">Select country</option>
                                <option value="Togo">Togo</option>
                                <option value="France">France</option>
                                <option value="Canada">Canada</option>
                                <option value="USA">USA</option>
                                <option value="UK">UK</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-field">
                            <label>Language</label>
                            <select @bind="userProfile.Language" disabled="@(!isEditing)">
                                <option value="">Select language</option>
                                <option value="French">Français</option>
                                <option value="English">English</option>
                                <option value="Spanish">Español</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Time Zone</label>
                            <select @bind="userProfile.TimeZone" disabled="@(!isEditing)">
                                <option value="">Select timezone</option>
                                <option value="Europe/Paris">Europe/Paris</option>
                                <option value="America/New_York">America/New_York</option>
                                <option value="America/Los_Angeles">America/Los_Angeles</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Email Section -->
                <div class="email-section">
                    <h3>My email Address</h3>
                    @foreach (var email in userProfile.EmailAddresses)
                    {
                        <div class="email-item">
                            <svg class="email-icon" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                            </svg>
                            <div class="email-details">
                                <p class="email-address">@email.Address</p>
                                <p class="email-date">@email.AddedDate</p>
                            </div>
                        </div>
                    }
                    <button class="add-email-btn" @onclick="AddEmailAddress">
                        + Add Email Address
                    </button>
                </div>

                <!-- Droits d'accès Section -->
                <div class="email-section">
                    <UserAccessRightsComponent ShowRefreshButton="false" />
                </div>

                @if (isEditing)
                {
                    <div class="save-section">
                        <MudButton OnClick="SaveChanges" 
                                   Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   Size="Size.Large"
                                   Disabled="@isSaving"
                                   Style="border-radius: 6px; text-transform: none; font-weight: 500;">
                            @if (isSaving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Sauvegarder
                        </MudButton>
                    </div>
                }
            </div>
        </div>
    </MudContainer>
</RequireAuth>

@code {
    private UserProfileModel userProfile = new UserProfileModel();
    private UserProfileDto? currentUser;
    private bool isEditing = false;
    private bool isSaving = false;
    private bool isLoading = true;

    // Modèle de données pour le profil utilisateur
    public class UserProfileModel
    {
        public string FullName { get; set; } = string.Empty;
        public string NickName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Gender { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
        public string Language { get; set; } = string.Empty;
        public string TimeZone { get; set; } = string.Empty;
        public string AvatarUrl { get; set; } = string.Empty;
        public List<EmailAddress> EmailAddresses { get; set; } = new List<EmailAddress>();
    }

    public class EmailAddress
    {
        public string Address { get; set; } = string.Empty;
        public string AddedDate { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserProfile();
    }

    private async Task LoadUserProfile()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Récupérer l'utilisateur actuel depuis le token JWT
            currentUser = await AuthService.GetCurrentUserAsync();
            
            if (currentUser != null)
            {
                // Récupérer le profil détaillé depuis l'API backend
                var profileResponse = await UserManagementService.GetUserProfileAsync();
                
                if (profileResponse.IsSuccess && profileResponse.Data != null)
                {
                    var backendProfile = profileResponse.Data;
                    
                    userProfile = new UserProfileModel
                    {
                        FullName = backendProfile.FullName ?? currentUser.FirstName + " " + currentUser.LastName,
                        Email = backendProfile.Email,
                        AvatarUrl = "/img/admin.jpg", // Image par défaut
                        EmailAddresses = new List<EmailAddress>
                        {
                            new EmailAddress 
                            { 
                                Address = backendProfile.Email, 
                                AddedDate = "Principal" 
                            }
                        }
                    };
                }
                else
                {
                    // Fallback avec les données du token JWT
                    userProfile = new UserProfileModel
                    {
                        FullName = (currentUser.FirstName + " " + currentUser.LastName).Trim(),
                        Email = currentUser.Email,
                        AvatarUrl = "/img/admin.jpg",
                        EmailAddresses = new List<EmailAddress>
                        {
                            new EmailAddress 
                            { 
                                Address = currentUser.Email, 
                                AddedDate = "Principal" 
                            }
                        }
                    };
                }
            }
            
            Logger.LogInformation(" Profil utilisateur chargé");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, " Erreur lors du chargement du profil utilisateur");
            
            // Fallback en cas d'erreur
            userProfile = new UserProfileModel
            {
                FullName = "Utilisateur",
                Email = "email@example.com",
                AvatarUrl = "/img/admin.jpg"
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleEdit()
    {
        isEditing = !isEditing;
        StateHasChanged();
    }

    private async Task SaveChanges()
    {
        if (isSaving) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            var updateDto = new UserProfileUpdateDto(
                Email: userProfile.Email,
                FullName: userProfile.FullName
            );

            var result = await UserManagementService.UpdateUserProfileAsync(updateDto);
            
            if (result.IsSuccess)
            {
                isEditing = false;
                Logger.LogInformation(" Profil utilisateur mis à jour avec succès");
            }
            else
            {
                Logger.LogWarning(" Échec de la mise à jour du profil: {ErrorMessage}", result.ErrorMessage);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, " Erreur lors de la sauvegarde du profil");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task AddEmailAddress()
    {
        // Simuler l'ajout d'une nouvelle adresse email
        // Dans une vraie application, on utiliserait un dialog approprié
        var newEmail = $"nouveau{userProfile.EmailAddresses.Count + 1}@example.com";
        
        var emailAddress = new EmailAddress
        {
            Address = newEmail,
            AddedDate = "Maintenant"
        };
        
        userProfile.EmailAddresses.Add(emailAddress);
        StateHasChanged();
        
        Logger.LogInformation("Nouvelle adresse email ajoutée: {Email}", newEmail);
    }

    private Color GetRoleColor(string role) => role.ToLower() switch
    {
        "admin" => Color.Error,
        "manager" => Color.Warning,
        "employee" => Color.Primary,
        "viewer" => Color.Info,
        _ => Color.Default
    };
}

