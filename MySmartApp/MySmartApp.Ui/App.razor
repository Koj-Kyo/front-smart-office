@using MudBlazor
@using MySmartApp.Ui.Themes
@inject NavigationManager NavigationManager
@inject ILogger<App> Logger

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<ErrorBoundary>
<ChildContent>
    <CascadingAuthenticationState>
        <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized Context="auth">
                    @if (auth.User?.Identity?.IsAuthenticated == true)
                    {
                        <LayoutView Layout="typeof(Layout.MainLayout)">
                            <div class="d-flex justify-center align-center" style="height: 100vh;">
                                <MudAlert Severity="Severity.Error">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-3" />
                                        <div>
                                            <MudText Typo="Typo.h6">Accès refusé</MudText>
                                            <MudText Typo="Typo.body2">Vous n'avez pas les permissions nécessaires pour accéder à cette page.</MudText>
                                        </div>
                                    </div>
                                </MudAlert>
                            </div>
                        </LayoutView>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <LayoutView Layout="typeof(Layout.MainLayout)">
                        <div class="d-flex justify-center align-center" style="height: 100vh;">
                            <MudProgressCircular Size="Size.Large" Indeterminate="true" />
                            <MudText Class="ml-3">Vérification de l'authentification...</MudText>
                        </div>
                    </LayoutView>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="d-flex justify-center align-center" style="height: 100vh;">
                    <MudAlert Severity="Severity.Error">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Error" Class="mr-3" />
                            <div>
                                <MudText Typo="Typo.h6">Page introuvable (404)</MudText>
                                <MudText Typo="Typo.body2">La page que vous recherchez n'existe pas.</MudText>
                            </div>
                        </div>
                    </MudAlert>
                </div>
            </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
    </ChildContent>
    <ErrorContent Context="exception">
        <div class="d-flex justify-center align-center" style="height: 100vh;">
            <MudAlert Severity="Severity.Error" Style="max-width: 600px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.BugReport" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.h6">Une erreur s'est produite</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3">L'application a rencontré une erreur inattendue.</MudText>
                        @if (_showErrorDetails)
                        {
                            <MudExpansionPanels>
                                <MudExpansionPanel IsInitiallyExpanded="false" Title="Détails de l'erreur">
                                    <div style="font-family: monospace; font-size: 12px; background: #f5f5f5; padding: 10px; border-radius: 4px;">
                                        <strong>Type:</strong> @exception.GetType().Name<br/>
                                        <strong>Message:</strong> @exception.Message<br/>
                                        @if (!string.IsNullOrWhiteSpace(exception.StackTrace))
                                        {
                                            <strong>Stack Trace:</strong><br/>
                                            <pre style="white-space: pre-wrap; margin: 5px 0;">@exception.StackTrace</pre>
                                        }
                                    </div>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }
                        <div class="mt-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ReloadApp())">
                                Recharger l'application
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => _showErrorDetails = !_showErrorDetails)" Class="ml-2">
                                @(_showErrorDetails ? "Masquer" : "Afficher") les détails
                            </MudButton>
                        </div>
                    </div>
                </div>
            </MudAlert>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private bool _isDarkMode = true;
    private MudTheme? _theme = null;
    private bool _showErrorDetails = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation("🚀 Initialisation de l'application...");
            
            // Initialisation du thème de manière sécurisée
            await InitializeThemeAsync();
            
            Logger.LogInformation("✅ Application initialisée avec succès");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Erreur lors de l'initialisation de l'application");
            
            // S'assurer qu'on a au minimum un thème par défaut
            _theme ??= new MudTheme();
        }
    }

    private async Task InitializeThemeAsync()
    {
        await Task.Run(() =>
        {
            try
            {
                _theme = MyTheme.GetTheme();
                Logger.LogDebug("✅ Thème chargé avec succès");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "⚠️ Erreur lors du chargement du thème, utilisation du thème par défaut");
                _theme = new MudTheme();
            }
        });
    }

    private void ReloadApp()
    {
        try
        {
            Logger.LogInformation("🔄 Rechargement de l'application demandé par l'utilisateur");
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Erreur lors du rechargement de l'application");
            // Fallback: rechargement par JavaScript
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
    }
}
