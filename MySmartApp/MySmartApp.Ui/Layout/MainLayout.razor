@inherits LayoutComponentBase
@using MudBlazor
@using MySmartApp.Ui.Layout
@using MySmartApp.Ui.Themes
@using MySmartApp.Ui.Services
@inject ILogger<MainLayout> Logger
@inject IThemeService ThemeService
@implements IDisposable

<MudLayout>
    <MudDrawer id="nav-drawer"
               @bind-Open="_drawerOpen"
               Elevation="3"
               Class="rounded-xl shadow-lg"
               Width="95px" Style="background-color: #7A40F2; color: white;">
        
        <NavMenu IsDarkMode="@_isDarkMode" OnToggleDarkMode="@DarkModeToggle" />
    </MudDrawer>
    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    protected override void OnInitialized()
    {
        try
        {
            Logger.LogDebug("🏗️ Initialisation du MainLayout");
            
            // S'abonner aux changements de thème
            ThemeService.OnThemeChanged += OnThemeChanged;
            _isDarkMode = ThemeService.IsDarkMode;
            
            base.OnInitialized();
            Logger.LogDebug("✅ MainLayout initialisé avec succès - Mode sombre: {IsDarkMode}", _isDarkMode);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Erreur lors de l'initialisation du MainLayout");
            throw; // Remonter l'erreur pour qu'elle soit capturée par l'ErrorBoundary
        }
    }

    private void OnThemeChanged()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        Logger.LogDebug("🌙 Thème changé: {IsDarkMode}", _isDarkMode);
        InvokeAsync(StateHasChanged);
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
        Logger.LogDebug("🎛️ Menu latéral basculé: {IsOpen}", _drawerOpen);
    }

    private async Task DarkModeToggle()
    {
        await ThemeService.ToggleThemeAsync();
        Logger.LogDebug("🌙 Mode sombre basculé via service: {IsDarkMode}", ThemeService.IsDarkMode);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };
}


