@using MudBlazor
@inject NavigationManager NavigationManager

<style>
    /* Style moderne de la barre de recherche */
    .modern-search-field {
        background-color: #f8f9fa;
        border-radius: 25px;
        border: none;
        padding: 12px 20px;
        font-size: 14px;
        width: 100%;
        max-width: 100px;
    }

    .modern-search-field .mud-input-root {
        border: none !important;
        background-color: transparent !important;
        box-shadow: none !important;
    }

    .modern-search-field .mud-input {
        border: none !important;
        background-color: transparent !important;
        padding: 0 !important;
    }

    .modern-search-field .mud-input:focus {
        box-shadow: none !important;
        border: none !important;
        outline: none !important;
    }

    .modern-search-field .mud-input-adornment {
        color: #6c757d;
        margin-right: 8px;
    }

    /* Style pour le mode sombre */
    .mud-theme-dark .modern-search-field {
        background-color: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .mud-theme-dark .modern-search-field .mud-input-adornment {
        color: rgba(255, 255, 255, 0.7);
    }

    /* Container pour centrer la recherche */
    .search-container {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        width: 10%;
    }

    /* Style pour le profil cliquable */
    .profile-section {
        display: flex;
        align-items: center;
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        transition: background-color 0.3s ease;
    }

    .profile-section:hover {
        background-color: rgba(0, 0, 0, 0.04);
    }

    .mud-theme-dark .profile-section:hover {
        background-color: rgba(255, 255, 255, 0.08);
    }
</style>

<MudGrid Class="pa-1">
    <MudItem xs="12" sm="6" md="8" Class="search-container">
        <MudSpacer />
        <MudTextField T="string" Placeholder="Rechercher..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </MudItem>
    <MudItem xs="12" sm="6" md="4" Class="d-flex justify-end align-center">
        <MudIconButton Icon="@Icons.Material.Outlined.Settings" Color="Color.Default" />
        <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Default" Class="mx-2" />
        
        @* Section profil cliquable *@
        <div class="profile-section" @onclick="NavigateToProfile">
            <MudAvatar Size="Size.Small">
                <MudImage Src="img/admin.jpg" />
            </MudAvatar>
            <MudText Typo="Typo.subtitle1" Class="ml-2">Admin</MudText>
        </div>
    </MudItem>
</MudGrid>

@code {
    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/profile");
    }
}