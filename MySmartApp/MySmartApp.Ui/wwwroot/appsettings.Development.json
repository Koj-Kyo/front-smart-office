{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Components.WebAssembly": "Debug",
      "System.Net.Http.HttpClient": "Information",
      "MySmartApp": "Debug"
    }
  },
  "ApiConfiguration": {
    "BaseUrl": "https://localhost:7144/api",
    "SwaggerUrl": "https://localhost:7144/swagger",
    "SignalRUrl": "https://localhost:7144/notificationhub",
    "TimeoutSeconds": 60,
    "RetryCount": 5,
    "RetryDelaySeconds": 1
  },
  "AppConfiguration": {
    "AppName": "Smart Office (Dev)",
    "Version": "1.0.0-dev",
    "Environment": "Development",
    "EnableAnalytics": false,
    "CacheTimeoutMinutes": 1,
    "SessionTimeoutMinutes": 120
  },
  "FeatureFlags": {
    "EnableRealTimeUpdates": true,
    "EnableOfflineMode": true,
    "EnableDarkModeToggle": true,
    "EnableDeveloperTools": true
  }
}
