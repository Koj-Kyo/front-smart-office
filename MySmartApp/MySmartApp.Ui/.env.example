# Configuration de l'API OpenWeather
# Obtenez votre clé gratuite sur https://openweathermap.org/api

# Clé API OpenWeather (OBLIGATOIRE)
OPENWEATHER_API_KEY=your_api_key_here

# Ville par défaut pour la météo
OPENWEATHER_DEFAULT_CITY=Brussels

# Instructions :
# 1. Créez un compte sur https://openweathermap.org/
# 2. Allez dans "API keys" dans votre profil
# 3. Copiez votre clé API
# 4. Remplacez "your_api_key_here" par votre clé
# 5. NE COMMITEZ JAMAIS ce fichier avec votre vraie clé !

# Pour l'utiliser dans l'application :
# - Développement : Modifiez wwwroot/appsettings.Development.json
# - Production : Modifiez wwwroot/appsettings.json
# - Ou utilisez des variables d'environnement Azure/serveur
