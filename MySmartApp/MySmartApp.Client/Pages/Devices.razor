@page "/devices"
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-8">
    <MudText Typo="Typo.h4" Class="mb-4">Gestion des appareils</MudText>
    <MudText Typo="Typo.body1" Class="mb-8">En tant qu'administrateur, vous pouvez ici ajouter, modifier et supprimer des appareils, et les affecter à une zone.</MudText>

    <MudButton OnClick="OpenAddDialog" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
        Ajouter un appareil
    </MudButton>

    <MudTable Items="@filteredDevices" Class="mt-8 rounded-xl" T="Device">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Liste des appareils</MudText>
            <MudSpacer />
            <MudTextField T="string" @bind-Value="searchString" Placeholder="Rechercher..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Nom</MudTh>
            <MudTh>Icône</MudTh>
            <MudTh>État</MudTh>
            <MudTh>Couleur</MudTh>
            <MudTh>Zone</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.DeviceName</MudTd>
            <MudTd DataLabel="Icon"><MudIcon Icon="@context.Icon" Style="@($"color:{context.DeviceColor};")" /></MudTd>
            <MudTd DataLabel="IsOn">@(context.IsOn ? "ON" : "OFF")</MudTd>
            <MudTd DataLabel="Color">
                <div style="@($"width: 20px; height: 20px; background-color:{context.DeviceColor}; border-radius: 50%;")"></div>
            </MudTd>
            <MudTd DataLabel="Zone">@context.Zone</MudTd>
            <MudTd>
                <MudIconButton OnClick="@(() => OpenEditDialog(context))" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
                <MudIconButton OnClick="@(() => DeleteDevice(context))" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

<MudOverlay @bind-Visible="isDialogOpen" DarkBackground="true" Absolute="false">
    <MudPaper Class="pa-6" Style="max-width: 500px; margin: 50px auto;">
        <MudText Typo="Typo.h6" Class="mb-4">
            <MudIcon Icon="@(isAdding ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)" Class="mr-3" />
            @(isAdding ? "Ajouter un appareil" : "Modifier l'appareil")
        </MudText>

        <MudTextField @bind-Value="editingDevice.DeviceName" 
                     Label="Nom de l'appareil" 
                     Required="true" 
                     Class="mb-4" />
        
        <MudSelect @bind-Value="editingDevice.Icon" 
                  Label="Icône" 
                  Required="true" 
                  Class="mb-4">
            <MudSelectItem Value="@Icons.Material.Filled.Lightbulb">💡 Ampoule</MudSelectItem>
            <MudSelectItem Value="@Icons.Material.Filled.AcUnit">❄️ Climatiseur</MudSelectItem>
            <MudSelectItem Value="@Icons.Material.Filled.Thermostat">🌡️ Thermostat</MudSelectItem>
            <MudSelectItem Value="@Icons.Material.Filled.Router">📡 Routeur</MudSelectItem>
            <MudSelectItem Value="@Icons.Material.Filled.Tv">📺 TV</MudSelectItem>
            <MudSelectItem Value="@Icons.Material.Filled.Speaker">🔊 Haut-parleur</MudSelectItem>
            <MudSelectItem Value="@Icons.Material.Filled.Camera">📷 Caméra</MudSelectItem>
        </MudSelect>
        
        <MudSelect @bind-Value="editingDevice.DeviceColor" 
                  Label="Couleur" 
                  Required="true" 
                  Class="mb-4">
            <MudSelectItem Value="@("#5850EC")">🔵 Bleu</MudSelectItem>
            <MudSelectItem Value="@("#FFD700")">🟡 Jaune</MudSelectItem>
            <MudSelectItem Value="@("#FF7F50")">🟠 Orange</MudSelectItem>
            <MudSelectItem Value="@("#00CED1")">🟢 Turquoise</MudSelectItem>
            <MudSelectItem Value="@("#FF6B6B")">🔴 Rouge</MudSelectItem>
            <MudSelectItem Value="@("#9C27B0")">🟣 Violet</MudSelectItem>
            <MudSelectItem Value="@("#4CAF50")">🟢 Vert</MudSelectItem>
            <MudSelectItem Value="@("#FF9800")">🟠 Ambré</MudSelectItem>
            <MudSelectItem Value="@("#607D8B")">⚪ Gris bleu</MudSelectItem>
            <MudSelectItem Value="@("#795548")">🤎 Marron</MudSelectItem>
        </MudSelect>
        
        <MudSwitch @bind-Value="editingDevice.IsOn" 
                  Label="Allumé" 
                  Color="Color.Primary" 
                  Class="mb-4" />
        
        <MudSelect @bind-Value="editingDevice.Zone" 
                  Label="Zone" 
                  Required="true" 
                  Class="mb-4">
            <MudSelectItem Value="@("Salon")">Salon</MudSelectItem>
            <MudSelectItem Value="@("Chambre")">Chambre</MudSelectItem>
            <MudSelectItem Value="@("Cuisine")">Cuisine</MudSelectItem>
            <MudSelectItem Value="@("Garage")">Garage</MudSelectItem>
            <MudSelectItem Value="@("Bureau")">Bureau</MudSelectItem>
            <MudSelectItem Value="@("Salle de bain")">Salle de bain</MudSelectItem>
        </MudSelect>

        <MudGrid Class="mt-4">
            <MudItem xs="6">
                <MudButton OnClick="OnCancel" FullWidth="true" Color="Color.Default">Annuler</MudButton>
            </MudItem>
            <MudItem xs="6">
                <MudButton OnClick="OnSave" FullWidth="true" Color="Color.Primary" Variant="Variant.Filled">
                    Sauvegarder
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudOverlay>

@code {
    private List<Device> devices = new List<Device>();
    private List<Device> filteredDevices => FilterDevices();
    private string searchString = "";
    private bool isDialogOpen = false;
    private bool isAdding = true;
    private Device editingDevice = new Device();

    public class Device
    {
        public int Id { get; set; }
        public string Icon { get; set; } = Icons.Material.Filled.Lightbulb;
        public string DeviceName { get; set; } = "";
        public string DeviceColor { get; set; } = "#5850EC";
        public bool IsOn { get; set; }
        public string Zone { get; set; } = "Salon";
    }

    private int nextId = 5;

    protected override void OnInitialized()
    {
        devices = new List<Device>
        {
            new Device { Id = 1, Icon = Icons.Material.Filled.AcUnit, DeviceName = "Climatiseur", DeviceColor = "#5850EC", IsOn = true, Zone = "Salon" },
            new Device { Id = 2, Icon = Icons.Material.Filled.Lightbulb, DeviceName = "Lumières", DeviceColor = "#FFD700", IsOn = true, Zone = "Cuisine" },
            new Device { Id = 3, Icon = Icons.Material.Filled.Thermostat, DeviceName = "Thermostat", DeviceColor = "#FF7F50", IsOn = true, Zone = "Chambre" },
            new Device { Id = 4, Icon = Icons.Material.Filled.Router, DeviceName = "Routeur", DeviceColor = "#00CED1", IsOn = false, Zone = "Bureau" }
        };
    }

    private List<Device> FilterDevices()
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return devices;

        return devices.Where(d => 
            d.DeviceName.ToLower().Contains(searchString.ToLower()) ||
            d.Zone.ToLower().Contains(searchString.ToLower())
        ).ToList();
    }

    private void OpenAddDialog()
    {
        isAdding = true;
        editingDevice = new Device();
        isDialogOpen = true;
    }

    private void OpenEditDialog(Device device)
    {
        isAdding = false;
        editingDevice = new Device
        {
            Id = device.Id,
            Icon = device.Icon,
            DeviceName = device.DeviceName,
            DeviceColor = device.DeviceColor,
            IsOn = device.IsOn,
            Zone = device.Zone
        };
        isDialogOpen = true;
    }

    private void OnCancel()
    {
        isDialogOpen = false;
        editingDevice = new Device();
    }

    private void OnSave()
    {
        if (string.IsNullOrWhiteSpace(editingDevice.DeviceName))
            return;

        if (isAdding)
        {
            editingDevice.Id = nextId++;
            devices.Add(editingDevice);
        }
        else
        {
            var existingDevice = devices.FirstOrDefault(d => d.Id == editingDevice.Id);
            if (existingDevice != null)
            {
                existingDevice.Icon = editingDevice.Icon;
                existingDevice.DeviceName = editingDevice.DeviceName;
                existingDevice.DeviceColor = editingDevice.DeviceColor;
                existingDevice.IsOn = editingDevice.IsOn;
                existingDevice.Zone = editingDevice.Zone;
            }
        }

        isDialogOpen = false;
        editingDevice = new Device();
    }

    private async Task DeleteDevice(Device device)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Confirmation",
            $"Êtes-vous sûr de vouloir supprimer l'appareil '{device.DeviceName}' ?",
            yesText:"Supprimer", cancelText:"Annuler");

        if (result == true)
        {
            devices.Remove(device);
        }
    }
}