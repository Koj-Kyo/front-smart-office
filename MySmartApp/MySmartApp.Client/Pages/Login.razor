@page "/login"

<MudContainer Fixed="true" Class="d-flex align-center justify-center flex-column" Style="height: 100vh;">
    <MudPaper Class="pa-8 rounded-xl" Width="400px" Elevation="6">
        <MudText Typo="Typo.h5" Class="mb-4">Se connecter</MudText>
        <MudTextField T="string" Label="Adresse email" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField T="string" Label="Mot de passe" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-6" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="LoginRedirect">
            Se connecter
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    [Inject] private NavigationManager NavManager { get; set; }

    private void LoginRedirect()
    {
        // Une fois la connexion réussie, redirigez l'utilisateur vers le tableau de bord.
        // C'est ici que vous gérerez la vraie logique d'authentification.
        NavManager.NavigateTo("/dashboard");
    }
}
