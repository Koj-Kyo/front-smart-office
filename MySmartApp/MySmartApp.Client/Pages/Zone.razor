@page "/zones"
@using MudBlazor
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-8">
    <MudText Typo="Typo.h4" Class="mb-4">Gestion des zones</MudText>
    <MudText Typo="Typo.body1" Class="mb-8">En tant qu'administrateur, vous pouvez ici gérer les zones, affecter des appareils et des utilisateurs.</MudText>

    <div class="d-flex align-center justify-space-between mb-4">
        <MudButton OnClick="OpenAddDialog" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            Ajouter une zone
        </MudButton>
        <MudTextField T="string" 
                      @bind-Value="searchString"
                      Placeholder="Rechercher..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search" 
                      IconSize="Size.Medium" 
                      Class="ml-4"
                      Style="max-width: 300px;"></MudTextField>
    </div>

    <MudExpansionPanels MultiExpansion="true" Class="rounded-xl">
        @foreach (var zone in filteredZones)
        {
            <MudExpansionPanel Text="@zone.Name">
                <ChildContent>
                    <div class="d-flex flex-column pa-4">
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.h6">Appareils</MudText>
                                @if (zone.Devices.Any())
                                {
                                    <MudList T="Device">
                                        @foreach (var device in zone.Devices)
                                        {
                                            <MudListItem T="Device" Icon="@device.Icon" Text="@device.DeviceName" />
                                        }
                                    </MudList>
                                }
                                else
                                {
                                    <MudText>Aucun appareil assigné.</MudText>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.h6">Membres</MudText>
                                @if (zone.Members.Any())
                                {
                                    <MudList T="Member">
                                        @foreach (var member in zone.Members)
                                        {
                                            <MudListItem T="Member" Text="@member.Name" />
                                        }
                                    </MudList>
                                }
                                else
                                {
                                    <MudText>Aucun membre assigné.</MudText>
                                }
                            </MudItem>
                        </MudGrid>
                    </div>
                    <div class="d-flex justify-end pa-2">
                        <MudIconButton OnClick="@(() => OpenEditDialog(zone))" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
                        <MudIconButton OnClick="@(() => DeleteZone(zone))" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" />
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
</MudContainer>

<MudOverlay @bind-Visible="isDialogOpen" DarkBackground="true" Absolute="false">
    <MudPaper Class="pa-6" Style="max-width: 600px; margin: 50px auto;">
        <MudText Typo="Typo.h6" Class="mb-4">
            <MudIcon Icon="@(isAdding ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)" Class="mr-3" />
            @(isAdding ? "Ajouter une zone" : "Modifier la zone")
        </MudText>

        <MudForm @ref="form">
            <MudTextField @bind-Value="editingZone.Name" 
                         Label="Nom de la zone" 
                         Required="true" 
                         RequiredError="Le nom est obligatoire!" 
                         Class="mb-4" />
            
            <MudSelect @bind-Value="editingZone.Icon" 
                      Label="Icône" 
                      Required="true" 
                      RequiredError="L'icône est obligatoire!"
                      Class="mb-4">
                <MudSelectItem Value="@Icons.Material.Filled.MeetingRoom">🛋️ Salon</MudSelectItem>
                <MudSelectItem Value="@Icons.Material.Filled.BedroomParent">🛏️ Chambre</MudSelectItem>
                <MudSelectItem Value="@Icons.Material.Filled.Kitchen">🍳 Cuisine</MudSelectItem>
                <MudSelectItem Value="@Icons.Material.Filled.Work">💼 Bureau</MudSelectItem>
                <MudSelectItem Value="@Icons.Material.Filled.Garage">🚗 Garage</MudSelectItem>
                <MudSelectItem Value="@Icons.Material.Filled.Bathroom">🛁 Salle de bain</MudSelectItem>
                <MudSelectItem Value="@Icons.Material.Filled.Deck">🌿 Terrasse</MudSelectItem>
                <MudSelectItem Value="@Icons.Material.Filled.Stairs">🪜 Escalier</MudSelectItem>
            </MudSelect>
            
            <MudSelect T="Device" 
                      Label="Appareils" 
                      MultiSelection="true" 
                      @bind-SelectedValues="selectedDevices"
                      Class="mb-4">
                @foreach (var device in MockDevices)
                {
                    <MudSelectItem Value="@device">@device.DeviceName</MudSelectItem>
                }
            </MudSelect>
            
            <MudSelect T="Member" 
                      Label="Membres" 
                      MultiSelection="true" 
                      @bind-SelectedValues="selectedMembers"
                      Class="mb-4">
                @foreach (var member in MockMembers)
                {
                    <MudSelectItem Value="@member">@member.Name</MudSelectItem>
                }
            </MudSelect>
        </MudForm>

        <MudGrid Class="mt-4">
            <MudItem xs="6">
                <MudButton OnClick="OnCancel" FullWidth="true" Color="Color.Default">Annuler</MudButton>
            </MudItem>
            <MudItem xs="6">
                <MudButton OnClick="OnSave" FullWidth="true" Color="Color.Primary" Variant="Variant.Filled">
                    Sauvegarder
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudOverlay>

@code {
    private List<ZoneModel> zones = new List<ZoneModel>();
    private List<ZoneModel> filteredZones => FilterZones();
    private string searchString = "";
    private bool isDialogOpen = false;
    private bool isAdding = true;
    private ZoneModel editingZone = new ZoneModel();
    private MudForm? form;
    private IEnumerable<Device> selectedDevices = new List<Device>();
    private IEnumerable<Member> selectedMembers = new List<Member>();
    private int nextId = 4;

    // Modèles de données
    public class ZoneModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Icon { get; set; } = Icons.Material.Filled.MeetingRoom;
        public List<Device> Devices { get; set; } = new List<Device>();
        public List<Member> Members { get; set; } = new List<Member>();

        public override string ToString() => Name;
        public override bool Equals(object? obj) => obj is ZoneModel zone && Id == zone.Id;
        public override int GetHashCode() => Id.GetHashCode();
    }

    public class Device
    {
        public int Id { get; set; }
        public string DeviceName { get; set; } = "";
        public string Icon { get; set; } = "";
        public string DeviceColor { get; set; } = "";
        public bool IsOn { get; set; }

        public override string ToString() => DeviceName;
        public override bool Equals(object? obj) => obj is Device device && Id == device.Id;
        public override int GetHashCode() => Id.GetHashCode();
    }

    public class Member
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string ImageUrl { get; set; } = "";
        public string Role { get; set; } = "";

        public override string ToString() => Name;
        public override bool Equals(object? obj) => obj is Member member && Id == member.Id;
        public override int GetHashCode() => Id.GetHashCode();
    }

    private List<Device> MockDevices = new List<Device>
    {
        new Device { Id = 1, DeviceName = "Climatiseur", Icon = Icons.Material.Filled.AcUnit, DeviceColor = "#5850EC", IsOn = true },
        new Device { Id = 2, DeviceName = "Lumières", Icon = Icons.Material.Filled.Lightbulb, DeviceColor = "#FFD700", IsOn = true },
        new Device { Id = 3, DeviceName = "Thermostat", Icon = Icons.Material.Filled.Thermostat, DeviceColor = "#FF7F50", IsOn = true },
        new Device { Id = 4, DeviceName = "Routeur", Icon = Icons.Material.Filled.Router, DeviceColor = "#00CED1", IsOn = false },
        new Device { Id = 5, DeviceName = "TV", Icon = Icons.Material.Filled.Tv, DeviceColor = "#9C27B0", IsOn = false },
        new Device { Id = 6, DeviceName = "Haut-parleur", Icon = Icons.Material.Filled.Speaker, DeviceColor = "#4CAF50", IsOn = true }
    };

    private List<Member> MockMembers = new List<Member>
    {
        new Member { Id = 1, Name = "Scarlett", ImageUrl = "https://i.pravatar.cc/100?img=1", Role = "Admin" },
        new Member { Id = 2, Name = "Nariya", ImageUrl = "https://i.pravatar.cc/100?img=2", Role = "Membre" },
        new Member { Id = 3, Name = "Riya", ImageUrl = "https://i.pravatar.cc/100?img=3", Role = "Membre" },
        new Member { Id = 4, Name = "Alexandre", ImageUrl = "https://i.pravatar.cc/100?img=4", Role = "Visiteur" }
    };

    protected override void OnInitialized()
    {
        zones = new List<ZoneModel>
        {
            new ZoneModel 
            { 
                Id = 1, 
                Name = "Salon", 
                Icon = Icons.Material.Filled.MeetingRoom, 
                Devices = MockDevices.GetRange(0, 2).ToList(), 
                Members = MockMembers.GetRange(0, 2).ToList() 
            },
            new ZoneModel 
            { 
                Id = 2, 
                Name = "Chambre", 
                Icon = Icons.Material.Filled.BedroomParent, 
                Devices = MockDevices.GetRange(2, 2).ToList(), 
                Members = MockMembers.GetRange(0, 1).ToList() 
            },
            new ZoneModel 
            { 
                Id = 3, 
                Name = "Cuisine", 
                Icon = Icons.Material.Filled.Kitchen, 
                Devices = new List<Device>(), 
                Members = new List<Member>() 
            }
        };
    }

    private List<ZoneModel> FilterZones()
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return zones;

        return zones.Where(z => 
            z.Name.ToLower().Contains(searchString.ToLower())
        ).ToList();
    }

    private void OpenAddDialog()
    {
        isAdding = true;
        editingZone = new ZoneModel 
        { 
            Name = "",
            Icon = Icons.Material.Filled.MeetingRoom
        };
        selectedDevices = new List<Device>();
        selectedMembers = new List<Member>();
        isDialogOpen = true;
    }

    private void OpenEditDialog(ZoneModel zone)
    {
        isAdding = false;
        // Créer une copie pour éviter la modification directe
        editingZone = new ZoneModel
        {
            Id = zone.Id,
            Name = zone.Name,
            Icon = zone.Icon,
            Devices = new List<Device>(zone.Devices),
            Members = new List<Member>(zone.Members)
        };
        selectedDevices = zone.Devices;
        selectedMembers = zone.Members;
        isDialogOpen = true;
    }

    private void OnCancel()
    {
        isDialogOpen = false;
        editingZone = new ZoneModel();
        selectedDevices = new List<Device>();
        selectedMembers = new List<Member>();
    }

    private async Task OnSave()
    {
        bool isValid = true;
        
        if (form != null)
        {
            await form.Validate();
            isValid = form.IsValid;
        }

        if (!isValid || string.IsNullOrWhiteSpace(editingZone.Name))
        {
            return;
        }

        // Mettre à jour les listes d'appareils et de membres
        editingZone.Devices = selectedDevices.ToList();
        editingZone.Members = selectedMembers.ToList();

        if (isAdding)
        {
            // Ajouter la nouvelle zone avec un ID unique
            editingZone.Id = nextId++;
            zones.Add(editingZone);
        }
        else
        {
            // Modifier la zone existante
            var existingZone = zones.FirstOrDefault(z => z.Id == editingZone.Id);
            if (existingZone != null)
            {
                existingZone.Name = editingZone.Name;
                existingZone.Icon = editingZone.Icon;
                existingZone.Devices = editingZone.Devices;
                existingZone.Members = editingZone.Members;
            }
        }

        isDialogOpen = false;
        editingZone = new ZoneModel();
        selectedDevices = new List<Device>();
        selectedMembers = new List<Member>();
        StateHasChanged();
    }

    private async Task DeleteZone(ZoneModel zone)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Confirmation",
            $"Êtes-vous sûr de vouloir supprimer la zone '{zone.Name}' ?",
            yesText:"Supprimer", cancelText:"Annuler");

        if (result == true)
        {
            zones.Remove(zone);
            StateHasChanged();
        }
    }
}