@page "/"
@rendermode InteractiveWebAssembly

<PageTitle>Smart Home App</PageTitle>

<MudContainer Fixed="true" Class="d-flex align-center justify-center flex-column text-center" Style="height: 100vh;">
    @* Conteneur interactif pour l'icône de la maison *@
    <MudPaper Elevation="4" Class="pa-6 rounded-xl mb-8 home-icon-animation"
              @onmouseenter="(() => _isHovered = true)"
              @onmouseleave="(() => _isHovered = false)">
        <MudIcon Icon="@(_isHovered? Icons.Material.Filled.House : Icons.Material.Outlined.House)"
                 Size="Size.Large"
                 Color="@(_isHovered ? Color.Primary : Color.Secondary)"
                 Style="font-size: 80px;" />
    </MudPaper>

    <MudText Typo="Typo.h2" GutterBottom="true" Class="fade-in">Bienvenue dans l'Application Smart Home</MudText>
    <MudText Typo="Typo.body1" Class="mb-8 fade-in-delay-1" Style="max-width: 600px;">
        Gérez tous vos appareils connectés à domicile depuis une interface simple et intuitive.
        Contrôlez l'éclairage, la température, la sécurité, et bien plus encore, où que vous soyez.
    </MudText>

    @* Le stack pour les deux boutons *@
    <MudStack Row="true" Spacing="2" Justify="Justify.Center" Class="fade-in-delay-2">
        <MudButton Href="/dashboard" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">
            Accéder au Tableau de Bord
        </MudButton>
        <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large">
            Se connecter
        </MudButton>
    </MudStack>
</MudContainer>

@code {
    private bool _isHovered = false;
}
