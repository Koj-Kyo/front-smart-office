@page "/access"
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-8">
    <MudText Typo="Typo.h4" Class="mb-4">Gestion des accès</MudText>
    <MudText Typo="Typo.body1" Class="mb-8">Gérez ici les droits d'accès des utilisateurs aux zones et aux appareils de votre maison intelligente.</MudText>

    <MudButton OnClick="OpenAddDialog" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mb-4">
        Attribuer des accès
    </MudButton>

    <MudExpansionPanels MultiExpansion="true" Class="rounded-xl">
        @foreach (var user in users)
        {
            <MudExpansionPanel Text="@user.Name">
                <ChildContent>
                    <div class="d-flex flex-column pa-4">
                        <MudText Typo="Typo.h6">Rôles</MudText>
                        <MudText Typo="Typo.body2">@user.Role</MudText>

                        <MudText Typo="Typo.h6" Class="mt-4">Zones accessibles</MudText>
                        @if (user.AccessibleZones.Any())
                        {
                            <MudList T="ZoneModel">
                                @foreach (var zone in user.AccessibleZones)
                                {
                                    <MudListItem T="ZoneModel" Text="@zone.Name" Icon="@zone.Icon" />
                                }
                            </MudList>
                        }
                        else
                        {
                            <MudText>Aucune zone assignée.</MudText>
                        }

                        <MudText Typo="Typo.h6" Class="mt-4">Appareils accessibles</MudText>
                        @if (user.AccessibleDevices.Any())
                        {
                            <MudList T="Device">
                                @foreach (var device in user.AccessibleDevices)
                                {
                                    <MudListItem T="Device" Text="@device.DeviceName" Icon="@device.Icon" />
                                }
                            </MudList>
                        }
                        else
                        {
                            <MudText>Aucun appareil assigné.</MudText>
                        }
                    </div>
                    <div class="d-flex justify-end pa-2">
                        <MudIconButton OnClick="@(() => OpenEditDialog(user))" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
                        <MudIconButton OnClick="@(() => DeleteUser(user))" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" />
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
</MudContainer>

<MudDialog @bind-IsVisible="isDialogOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(isAdding? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)" Class="mr-3" />
            @(isAdding ? "Attribuer des accès" : "Modifier les accès")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm>
            <MudSelect T="User" Label="Sélectionner un utilisateur" @bind-Value="editingUser" Required>
                @foreach (var user in users)
                {
                    <MudSelectItem Value="@user">@user.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="ZoneModel" Label="Zones accessibles" MultiSelection="true" @bind-SelectedValues="selectedZones">
                @foreach (var zone in zones)
                {
                    <MudSelectItem Value="@zone">@zone.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Device" Label="Appareils accessibles" MultiSelection="true" @bind-SelectedValues="selectedDevices">
                @foreach (var device in devices)
                {
                    <MudSelectItem Value="@device">@device.DeviceName</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancel" Color="Color.Default">Annuler</MudButton>
        <MudButton OnClick="OnSave" Color="Color.Primary" Variant="Variant.Filled">Sauvegarder</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<User> users = new List<User>();
    private List<ZoneModel> zones = new List<ZoneModel>();
    private List<Device> devices = new List<Device>();
    private bool isDialogOpen = false;
    private bool isAdding = true;
    private User editingUser = new User();
    private DialogOptions dialogOptions = new DialogOptions() { CloseButton = true };
    private IEnumerable<ZoneModel> selectedZones { get; set; } = new List<ZoneModel>();
    private IEnumerable<Device> selectedDevices { get; set; } = new List<Device>();

    // Modèles de données
    public class User
    {
        public string Name { get; set; }
        public string Role { get; set; }
        public List<ZoneModel> AccessibleZones { get; set; } = new List<ZoneModel>();
        public List<Device> AccessibleDevices { get; set; } = new List<Device>();
        public bool IsActive { get; set; }

        public override string ToString() => Name;
    }

    public class ZoneModel
    {
        public string Name { get; set; }
        public string Icon { get; set; }

        public override string ToString() => Name;
    }

    public class Device
    {
        public string DeviceName { get; set; }
        public string Icon { get; set; }

        public override string ToString() => DeviceName;
    }

    protected override void OnInitialized()
    {
        // Données d'appareils et de zones fictives
        devices = new List<Device>
        {
            new Device { DeviceName = "Climatiseur", Icon = Icons.Material.Filled.AcUnit },
            new Device { DeviceName = "Lumières", Icon = Icons.Material.Filled.Lightbulb },
            new Device { DeviceName = "Thermostat", Icon = Icons.Material.Filled.Thermostat },
            new Device { DeviceName = "Routeur", Icon = Icons.Material.Filled.Router }
        };

        zones = new List<ZoneModel>
        {
            new ZoneModel { Name = "Salon", Icon = Icons.Material.Filled.MeetingRoom },
            new ZoneModel { Name = "Chambre", Icon = Icons.Material.Filled.BedroomParent },
            new ZoneModel { Name = "Cuisine", Icon = Icons.Material.Filled.Kitchen },
        };

        // Données d'utilisateurs fictives
        users = new List<User>
        {
            new User { Name = "Scarlett", Role = "Admin", IsActive = true, AccessibleZones = zones, AccessibleDevices = devices },
            new User { Name = "Nariya", Role = "Membre", IsActive = true, AccessibleZones = zones.GetRange(0, 1), AccessibleDevices = devices.GetRange(0, 2) },
            new User { Name = "Riya", Role = "Visiteur", IsActive = false, AccessibleZones = new List<ZoneModel>(), AccessibleDevices = new List<Device>() }
        };
    }

    private void OpenAddDialog()
    {
        isAdding = true;
        editingUser = new User();
        selectedZones = new List<ZoneModel>();
        selectedDevices = new List<Device>();
        isDialogOpen = true;
    }

    private void OpenEditDialog(User user)
    {
        isAdding = false;
        editingUser = user;
        selectedZones = user.AccessibleZones;
        selectedDevices = user.AccessibleDevices;
        isDialogOpen = true;
    }

    private void OnCancel()
    {
        isDialogOpen = false;
    }

    private void OnSave()
    {
        if (isAdding)
        {
            editingUser.AccessibleZones = selectedZones.ToList();
            editingUser.AccessibleDevices = selectedDevices.ToList();
            users.Add(editingUser);
        }
        else
        {
            editingUser.AccessibleZones = selectedZones.ToList();
            editingUser.AccessibleDevices = selectedDevices.ToList();
        }
        isDialogOpen = false;
        StateHasChanged();
    }

    private void DeleteUser(User user)
    {
        users.Remove(user);
        StateHasChanged();
    }
}
