@page "/profile"
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-8">
    <MudText Typo="Typo.h4" Class="mb-4">Mon profil</MudText>
    <MudText Typo="Typo.body1" Class="mb-8">Gérez ici les paramètres de votre compte et vos informations personnelles.</MudText>

    <MudPaper Class="pa-8 rounded-xl" Elevation="6">
        <MudForm>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  @bind-Value="adminProfile.Name"
                                  Label="Nom complet"
                                  ReadOnly />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  @bind-Value="adminProfile.Email"
                                  Label="Adresse email"
                                  ReadOnly />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string"
                                  @bind-Value="adminProfile.Role"
                                  Label="Rôle"
                                  ReadOnly />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mt-8 mb-4">Changer le mot de passe</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  InputType="InputType.Password"
                                  Label="Nouveau mot de passe"
                                  @bind-Value="newPassword"
                                  Required />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  InputType="InputType.Password"
                                  Label="Confirmer le mot de passe"
                                  @bind-Value="confirmPassword"
                                  Required />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end mt-8">
                <MudButton OnClick="SaveChanges" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">
                    Sauvegarder les changements
                </MudButton>
            </div>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private UserModel adminProfile = new UserModel();
    private string newPassword;
    private string confirmPassword;

    // Modèle de données pour l'utilisateur
    public class UserModel
    {
        public string Name { get; set; }
        public string Email { get; set; }
        public string Role { get; set; }
        public string Password { get; set; }
    }

    protected override void OnInitialized()
    {
        // Données fictives de l'administrateur
        adminProfile = new UserModel
        {
            Name = "Scarlett",
            Email = "scarlett@example.com",
            Role = "Administrateur"
        };
    }

    private void SaveChanges()
    {
        // Logique pour sauvegarder les changements
        // (Par exemple, un appel à une API)
        if (newPassword == confirmPassword)
        {
            adminProfile.Password = newPassword;
            // Affiche un message de succès (à implémenter)
        }
        else
        {
            // Affiche un message d'erreur (à implémenter)
        }
    }
}
