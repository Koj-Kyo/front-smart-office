<MudPaper Class="d-flex flex-column pa-4 rounded-xl" Style="@($"background-color: {GetColor(DeviceColor, IsOn)}; cursor: pointer; border: {(IsSelected ? "2px solid #5850EC" : "2px solid transparent")};")"
          @onclick="OnCardClick">

    @* En-tête avec l'icône *@
    <div class="d-flex justify-center align-center">
        <MudIcon Icon="@Icon" Color="@(IsOn? Color.Surface: Color.Primary)" Size="Size.Large" />
    </div>

    @* Nom de l'appareil et statut *@
    <div class="mt-auto">
        <MudText Typo="Typo.body1" Class="mt-2" Style="@($"color: {(IsOn ? "white" : "black")};")">
            @DeviceName
        </MudText>
        <MudText Typo="Typo.caption" Class="mt-1" Style="@($"color: {(IsOn ? "white" : "black")};")">
            @(IsOn ? "ON" : "OFF")
        </MudText>
    </div>
</MudPaper>

@code {
    [Parameter]
    public string Icon { get; set; } = string.Empty;

    [Parameter]
    public string DeviceName { get; set; } = string.Empty;

    [Parameter]
    public string DeviceColor { get; set; } = string.Empty;

    [Parameter]
    public bool IsOn { get; set; } = false;

    [Parameter]
    public bool IsSelected { get; set; } = false;

    [Parameter]
    public EventCallback<string> OnDeviceSelected { get; set; }

    private string GetColor(string color, bool isOn)
    {
        if (isOn)
        {
            return color switch
            {
                "Purple" => "#5850EC",
                "Yellow" => "#FFD700",
                "Orange" => "#FF7F50",
                "Cyan" => "#00CED1",
                _ => "#5850EC", // Couleur par défaut lorsque la carte est allumée
            };
        }
        else
        {
            return "#F4F6F9"; // Couleur par défaut lorsque la carte est éteinte
        }
    }

    private MudBlazor.Color GetMudColor(string color)
    {
        return color switch
        {
            "Purple" => MudBlazor.Color.Primary,
            "Yellow" => MudBlazor.Color.Warning,
            "Orange" => MudBlazor.Color.Error,
            "Cyan" => MudBlazor.Color.Info,
            _ => MudBlazor.Color.Primary,
        };
    }

    private async Task OnCardClick()
    {
        IsOn = !IsOn;
        await OnDeviceSelected.InvokeAsync(DeviceName);
        StateHasChanged();
    }
}
