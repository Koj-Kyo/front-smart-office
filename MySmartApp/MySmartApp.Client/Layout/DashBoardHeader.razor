@using MudBlazor

<style>
    /* Style moderne de la barre de recherche */
    .modern-search-field {
        background-color: #f8f9fa;
        border-radius: 25px;
        border: none;
        padding: 12px 20px;
        font-size: 14px;
        width: 100%;

        max-width: 100px;
    }

    .modern-search-field .mud-input-root {
        border: none !important;
        background-color: transparent !important;
        box-shadow: none !important;
    }

    .modern-search-field .mud-input {
        border: none !important;
        background-color: transparent !important;
        padding: 0 !important;
    }

    .modern-search-field .mud-input:focus {
        box-shadow: none !important;
        border: none !important;
        outline: none !important;
    }

    .modern-search-field .mud-input-adornment {
        color: #6c757d;
        margin-right: 8px;
    }

    /* Style pour le mode sombre */
    .mud-theme-dark .modern-search-field {
        background-color: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .mud-theme-dark .modern-search-field .mud-input-adornment {
        color: rgba(255, 255, 255, 0.7);
    }

    /* Container pour centrer la recherche */
    .search-container {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        width: 10%;
    }

</style>

<MudGrid Class="pa-1">
    <MudItem xs="12" sm="6" md="8" Class="search-container">
        <MudSpacer />
            <MudTextField T="string" Placeholder="Rechercher..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        
    </MudItem>
    <MudItem xs="12" sm="6" md="4" Class="d-flex justify-end align-center">
        <MudIconButton Icon="@Icons.Material.Outlined.Settings" Color="Color.Default" />
        <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Default" Class="mx-2" />
        <MudAvatar Size="Size.Small">
            <MudImage Src="img/admin.jpg" />
        </MudAvatar>
        <MudIconButton Typo="Typo.subtitle1" Class="ml-2">Admin</MudIconButton>
        @* <MudIconButton Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" /> *@
    </MudItem>
</MudGrid>

